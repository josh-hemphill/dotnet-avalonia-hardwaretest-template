<?xml version="1.0" encoding="UTF-8"?>
<Package Name="HardwareTest Template Program" xmlns="http://opentap.io/schemas/package" Version="0.1.0" OS="Windows,Linux,MacOS">
  <Description>
    Copy-target locked program: sample.TapPlan plus session/DUT/Typst sidecar.
    Depends on HardwareTest Basic and Mixins (same versions as the bench).
    Product plans add InstrumentComponents.OpenTap for typed SCPI instruments and steps.
  </Description>
  <Owner>HardwareTest</Owner>
  <Dependencies>
    <PackageDependency Package="OpenTAP" Version="^9.32.2" />
    <PackageDependency Package="HardwareTest Basic" Version="^0.1.0" />
    <PackageDependency Package="HardwareTest Mixins" Version="^0.1.0" />
    <!-- Product packs that use typed SCPI instruments add:
         <PackageDependency Package="InstrumentComponents.OpenTap" Version="^0.1.0" />
         Install that pack in Editor/TUI and on the bench. Sample/board-demo stay Basic so this template pack does not declare it.
         Product packs that use OpenTAP Expressions steps add:
         <PackageDependency Package="Expressions" Version="^1.5.0" /> -->
  </Dependencies>
  <Files>
    <File Path="sample.TapPlan" />
    <File Path="sample.program.json" />
    <File Path="template.program.json" />
    <File Path="program.schema.json" />
  </Files>
</Package>
