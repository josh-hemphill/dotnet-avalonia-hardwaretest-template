{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardwaretest.local/authoring.schema.json",
  "title": "HardwareTest authoring workspace",
  "description": "Versioned planning-directory manifest. Instrument requirements belong in TapPackage Dependencies. Session/DUT/Typst stay in {planId}.program.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema for editor intellisense."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Persisted document schema. Greater than the app current version loads read-only."
    },
    "displayName": { "type": "string" },
    "plansDirectory": {
      "type": "string",
      "description": "Directory of *.TapPlan files, relative to this manifest. Top-level only."
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "optionalDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "when": { "type": "string" }
        }
      }
    },
    "instrumentComponentsPackage": {
      "type": ["string", "null"],
      "description": "Path to InstrumentComponents.OpenTap TapPackage, or omit and use HARDWARETEST_INSTRUMENT_COMPONENTS_PACKAGE."
    },
    "pluginProjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "shellAppProjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excludedProgramIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "includeTui": { "type": "boolean" },
    "recordingsDirectory": {
      "type": "string",
      "description": "Directory of operator run.json goldens, relative to this manifest. Default recordings. Unused until recordings consume lands; the folder need not exist."
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Workspace report kinds, program kinds, required DUT field ids, instrument slot suggestions, and independent hardware templates. Program membership and runtime bindings remain separate.",
      "properties": {
        "reportKinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "programKinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "instrumentSlotNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "hardware": {
          "type": "array",
          "description": "Optional hardware templates with stable identities. Explicit inclusion copies a template into one program; edits do not retarget existing program bindings.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "typeId", "address", "settings"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "typeId": { "type": "string" },
              "address": { "type": "string" },
              "settings": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
