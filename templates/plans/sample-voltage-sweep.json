{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "sample-voltage-sweep",
  "name": "Sample Voltage Sweep",
  "description": "Demo plan using mock VISA that opens a session, identifies the instrument, acquires samples, and asserts a threshold.",
  "dutSerial": "DUT-DEMO-001",
  "resource": "MOCK::INSTR0",
  "steps": [
    { "type": "Open", "resource": "MOCK::INSTR0" },
    { "type": "Write", "command": "*RST" },
    { "type": "Query", "command": "*IDN?", "storeAs": "idn" },
    { "type": "Write", "command": "CONF:VOLT:DC" },
    { "type": "Acquire", "channel": "VDC", "sampleCount": 64, "intervalMs": 10 },
    { "type": "Assert", "source": "channel:VDC:mean", "operator": "gte", "value": 0.0 },
    { "type": "Delay", "milliseconds": 50 },
    { "type": "Write", "command": "SYST:LOC" }
  ]
}
