<Project>
  <!-- The v3 runner's delayed shutdown diagnostic corrupts the metadata JSON protocol
       when Windows process shutdown takes more than a second. Only metadata uses
       the public EntryPoint API directly; normal runs retain xUnit's leak detector. -->
  <PropertyGroup Condition="'$(TestProject)' == 'true'">
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
  <ItemGroup Condition="'$(TestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/XunitMetadataEntryPoint.cs" Link="XunitMetadataEntryPoint.cs" />
  </ItemGroup>
</Project>
