<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The published Instrument Components embedded model registry uses reflection JSON.
         This execution process remains untrimmed; application persistence uses generated contexts. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="InstrumentComponents.OpenTap.Visa" PrivateAssets="all" />
    <PackageReference Include="OpenTAP" PrivateAssets="all" />
    <ProjectReference Include="../../src/HardwareTest.OpenTap.Host/HardwareTest.OpenTap.Host.csproj" />
  </ItemGroup>
</Project>
