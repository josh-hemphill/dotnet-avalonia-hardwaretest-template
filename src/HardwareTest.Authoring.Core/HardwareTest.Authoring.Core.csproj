<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>HardwareTest.Authoring</RootNamespace>
    <Description>Avalonia-free OpenTAP authoring workspace, compile, and pack</Description>
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HardwareTest.Authoring.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HardwareTest.Authoring.UI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>HardwareTest.StandaloneVisa.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTAP" />
    <PackageReference Include="Parlot" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\HardwareTest.Core\HardwareTest.Core.csproj" />
    <ProjectReference Include="..\HardwareTest.OpenTap.Host\HardwareTest.OpenTap.Host.csproj" />
    <ProjectReference Include="..\HardwareTest.OpenTap.Plugins.Basic\HardwareTest.OpenTap.Plugins.Basic.csproj" />
    <ProjectReference Include="..\HardwareTest.OpenTap.Plugins.Mixins\HardwareTest.OpenTap.Plugins.Mixins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../HardwareTest.OpenTap.Plugins.Basic/package.xml" Link="AuthoringPackages/HardwareTest Basic/package.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../HardwareTest.OpenTap.Plugins.Mixins/package.xml" Link="AuthoringPackages/HardwareTest Mixins/package.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../plans/opentap/authoring.schema.json" LogicalName="HardwareTest.Authoring.authoring.schema.json" />
    <EmbeddedResource Include="../../plans/opentap/authoring-draft.schema.json" LogicalName="HardwareTest.Authoring.authoring-draft.schema.json" />
  </ItemGroup>
  <!-- OpenTAP exposes this as runtime payload. Resolve after its imported target metadata. -->
  <Target Name="ReferenceOpenTapPackage" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="OpenTap.Package">
        <HintPath>$([System.String]::Copy('$(OpenTapRuntimeDir)').Replace('osx-', 'macos-'))/OpenTap.Package.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
