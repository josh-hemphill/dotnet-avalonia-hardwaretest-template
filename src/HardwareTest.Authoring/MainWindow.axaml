<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.MainWindow" x:DataType="vm:AuthoringWorkspaceViewModel"
    Background="{DynamicResource AuthoringCanvas}" Title="HardwareTest Authoring" Width="1280" Height="800" MinWidth="960" MinHeight="600">
  <Window.Styles>
    <Style Selector="Button.authoringAction">
      <Setter Property="ContentTemplate" Value="{x:Static vm:AuthoringActionLabels.WrappedText}"/>
    </Style>
  </Window.Styles>
  <Panel>
  <DockPanel IsEnabled="{Binding !LoadingBusy}">
    <ContentControl x:Name="IssuesDrawer" DockPanel.Dock="Bottom" MaxHeight="180" IsVisible="False" Margin="12"/>
    <Border DockPanel.Dock="Top" Background="{DynamicResource AuthoringSurface}" BorderBrush="{DynamicResource AuthoringLine}" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <Button x:Name="LifecycleFocusTarget" Content="Workspace ▾" AutomationProperties.Name="Workspace actions" Classes="authoringAction">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="430" Width="280" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="6" Classes="workspaceMenu">
                    <TextBlock Text="WORKSPACE" Classes="eyebrow" Margin="4,4,0,8"/>
                    <Button Content="Create workspace…" Click="OnCreateWorkspace" AutomationProperties.Name="Create workspace from menu" Classes="authoringAction"/>
                    <Button Content="Open workspace…" Click="OnOpenWorkspace"
            ToolTip.Tip="Open a folder that contains authoring.json" AutomationProperties.Name="Open workspace"
            Classes="authoringAction"/>
<Button Content="Prepare authoring environment" Click="OnBootstrap" IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Prepare required packages in this workspace’s isolated OpenTAP home"
            AutomationProperties.Name="Prepare authoring environment" Classes="authoringAction"/>
<Button Content="Undo catalog" Click="OnUndoWorkspace" IsEnabled="{Binding CanUndoWorkspace}"
            AutomationProperties.Name="Undo workspace catalog" ToolTip.Tip="{Binding WorkspaceHistoryHint}"
            Classes="authoringAction"/>
<Button Content="Redo catalog" Click="OnRedoWorkspace" IsEnabled="{Binding CanRedoWorkspace}"
            AutomationProperties.Name="Redo workspace catalog" ToolTip.Tip="{Binding WorkspaceHistoryHint}"
            Classes="authoringAction"/>
<Button Content="Save sidecar" Click="OnSaveSidecar" IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Save sidecar settings and authoring source without compiling the TapPlan."
            AutomationProperties.Name="Save sidecar" Classes="authoringAction"/>
<Button Content="Save draft / compile" Classes="accent authoringAction" Click="OnApply"
            IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Save authoring source, including incomplete values; export compiled files when ready"
            AutomationProperties.Name="Save plan"/>
<Button Content="{Binding SettingsTitle}" Click="OnOpenSettings" ToolTip.Tip="{Binding SettingsPurpose}"
            AutomationProperties.Name="Open settings" Classes="authoringAction"/>
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        <ContentControl Grid.Column="1" IsVisible="{Binding HasWorkspace}"><ComboBox x:Name="PlanSelector" MinHeight="40" PlaceholderText="No test plans yet" KeyDown="OnProgramsKeyDown" MinWidth="150" MaxWidth="260" ItemsSource="{Binding ProgramRows}" SelectedItem="{Binding SelectedProgramRow, Mode=OneWay}" SelectionChanged="OnPlanSelectionChanged" AutomationProperties.Name="Selected test plan" ToolTip.Tip="Switch plans; each plan retains its draft">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AuthoringProgramRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlanId}"/><TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource AuthoringAccent}" IsVisible="{Binding DirtyMarker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{Binding DirtyMarker}"/></Grid>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox></ContentControl>
        <ContentControl Grid.Column="2" IsVisible="{Binding HasWorkspace}"><Button x:Name="PlanActionsButton" Content="Plan ▾" Classes="authoringAction" AutomationProperties.Name="Plan actions">
              <Button.Flyout><Flyout><ScrollViewer Width="250" MaxHeight="360" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Classes="workspaceMenu">

                  <Button Content="Undo" Click="OnUndo" IsEnabled="{Binding CanUndo}" AutomationProperties.Name="Undo selected program" Classes="authoringAction"/>
                  <Button Content="Redo" Click="OnRedo" IsEnabled="{Binding CanRedo}" AutomationProperties.Name="Redo selected program" Classes="authoringAction"/>
                  <Button Content="Preview" Tag="5" Click="OnNavigateTask" AutomationProperties.Name="Open full preview" Classes="authoringAction"/>
                <Button Content="New test plan" Click="OnCreateProgram" IsEnabled="{Binding CanInitializePlan}" Classes="authoringAction" AutomationProperties.Name="New test plan"/>
                <Button Content="Guided voltage test…" ToolTip.Tip="Create a voltage test with guided setup and checks" Click="OnGuidedStart" IsEnabled="{Binding CanInitializePlan}" Classes="authoringAction" AutomationProperties.Name="Start guided voltage test"/>
                <Button Content="{Binding RemoveProgramTitle}" Click="OnRemoveProgram" IsEnabled="{Binding CanRemoveSelectedProgram}" ToolTip.Tip="{Binding RemoveProgramPurpose}" Classes="authoringAction" AutomationProperties.Name="Remove program"/>
              </StackPanel></ScrollViewer></Flyout></Button.Flyout>
            </Button></ContentControl>
        <Button Grid.Column="3" Content="Save all" Click="OnSaveAll" IsEnabled="{Binding HasWorkspace}" IsVisible="{Binding HasWorkspace}" AutomationProperties.Name="Save all" Classes="accent authoringAction"/>
        <Button Grid.Column="4" Content="Check" Click="OnValidate" IsEnabled="{Binding HasWorkspace}" IsVisible="{Binding HasWorkspace}" ToolTip.Tip="Check saved TapPlans in this workspace" AutomationProperties.Name="Validate workspace" Classes="authoringAction"/>
        <Button Grid.Column="5" x:Name="CommandPaletteButton" Content="Commands" Click="OnOpenCommandPalette" AutomationProperties.Name="Command palette" Classes="authoringAction"/>
        <Button Grid.Column="6" Content="Guidance" Click="OnResumeGuidance" IsVisible="{Binding HasWorkspace}" Classes="authoringAction" AutomationProperties.Name="Resume guidance"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource AuthoringSurface}" BorderBrush="{DynamicResource AuthoringLine}" BorderThickness="0,1,0,0" Padding="16,6">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" MinHeight="32">
          <TextBlock x:Name="StatusLabel" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ValidationScope}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Authoring status"/>
          <TextBlock Grid.Column="1" Text="Unsaved changes" IsVisible="{Binding HasUnsavedChanges}" VerticalAlignment="Center" Foreground="{DynamicResource AuthoringAccent}" AutomationProperties.Name="Unsaved changes"/>
          <Button Grid.Column="2" Content="Details" Click="OnShowOperationDetails" IsVisible="{Binding HasWorkspace}" Classes="authoringAction" AutomationProperties.Name="View operation details" ToolTip.Tip="Full save results, errors and operation logs"/>
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" MinHeight="18">
          <TextBlock Text="{Binding ValidationScope}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ValidationScope}" AutomationProperties.Name="Validation scope"/>
          <TextBlock Grid.Column="1" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="12" MaxLines="1" Foreground="{DynamicResource AuthoringError}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Error}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Authoring error"/>
        </Grid>
        <Grid IsVisible="{Binding OperationBusy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Button Content="Cancel operation" Click="OnCancelOperation" AutomationProperties.Name="Cancel authoring operation" Classes="authoringAction"/>
          <TextBlock Grid.Column="1" Text="{Binding OperationStage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
          <Button Grid.Column="2" Content="Operation logs" Click="OnShowOperationDetails" Classes="authoringAction" AutomationProperties.Name="Authoring operation logs"/>
        </Grid>
      </StackPanel>
    </Border>
    <Panel>
      <ScrollViewer x:Name="WelcomeViewport" IsVisible="{Binding !HasWorkspace}" Margin="24"
          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ClipToBounds="True"
          AutomationProperties.Name="Workspace welcome viewport">
        <Border x:Name="WelcomeSurface" Padding="40" HorizontalAlignment="Center"
            VerticalAlignment="Center" MaxWidth="600" Classes="surface">
          <StackPanel Spacing="18">
            <TextBlock Text="TEST PLAN AUTHORING" Classes="eyebrow" HorizontalAlignment="Center"/>
            <TextBlock Text="Create your test workspace" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                AutomationProperties.HeadingLevel="1"/>
            <TextBlock
                Text="Create a workspace to organize your test plans, hardware and recordings. Open an existing workspace to continue editing." TextAlignment="Center" Foreground="{DynamicResource AuthoringMuted}"
                TextWrapping="Wrap"/>
            <StackPanel Spacing="8">
              <Button Content="Create workspace" MinHeight="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnCreateWorkspace"
                  AutomationProperties.Name="Create workspace from welcome" Classes="accent authoringAction"/>
              <Button Content="Open workspace…" Click="OnOpenWorkspace"
                  AutomationProperties.Name="Open workspace from welcome" HorizontalAlignment="Center" Classes="authoringAction"/>
              <Button Content="{Binding LastWorkspaceOffer}" Click="OnOpenLastWorkspace"
                  IsVisible="{Binding CanOfferLastWorkspace}" ToolTip.Tip="{Binding LastWorkspacePath}"
                  AutomationProperties.Name="Open last workspace from welcome" HorizontalAlignment="Center" Classes="authoringAction"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
      <Grid x:Name="WorkspaceLayout" RowDefinitions="Auto,*" Margin="16,8,16,8" IsVisible="{Binding HasWorkspace}">
        <Grid x:Name="PlanNavigationBar" ColumnDefinitions="Auto,1.1*,1.35*,1.5*,1*,1.4*,.85*,.75*,Auto" ColumnSpacing="4" Margin="0,0,0,8">
          <Button x:Name="RouteBackButton" Content="Back" Click="OnNavigateBack" IsEnabled="False" AutomationProperties.Name="Back to previous section" ToolTip.Tip="Previous section (Alt+Left)" Classes="authoringAction"/>
          <ToggleButton Grid.Column="1" Content="Sequence" Tag="0" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Sequence" ToolTip.Tip="Sequence"/>
          <ToggleButton Grid.Column="2" Content="Instruments" Tag="1" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Instruments" ToolTip.Tip="Instruments"/>
          <ToggleButton Grid.Column="3" Content="Operator &amp; reports" Tag="7" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Operator &amp; reports" ToolTip.Tip="Operator &amp; reports"/>
          <ToggleButton Grid.Column="4" Content="Preview" Tag="5" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Preview" ToolTip.Tip="Preview"/>
          <ToggleButton Grid.Column="5" Content="Environment" Tag="3" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Environment" ToolTip.Tip="Environment"/>
          <ToggleButton Grid.Column="6" Content="Issues" Tag="2" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Issues" ToolTip.Tip="Issues"/>
          <ToggleButton Grid.Column="7" Content="Build" Tag="4" Click="OnNavigateTask" Classes="taskRoute" AutomationProperties.Name="Task Build" ToolTip.Tip="Build"/>
          <ContentControl Grid.Column="8"><Button x:Name="TaskMenuButton" Content="More ▾" AutomationProperties.Name="Switch task" Classes="authoringAction">
              <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><ScrollViewer Width="270" MaxHeight="420" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6" Classes="workspaceMenu">
                <Button Content="Overview" Tag="8" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Workspace overview"/><Button Content="Sequence" Tag="0" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Sequence"/>
                <Button Content="Instruments" Tag="1" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Instruments"/>
                <Button Content="Operator &amp; reports" Tag="7" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Operator and reports"/>
                <Button Content="Operator preview" Tag="5" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Operator preview"/>
                <Button Content="Environment" Tag="3" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Environment"/>
                <Button Content="Build &amp; package" Tag="4" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Build and package"/>
                <Button Content="Issues" Tag="2" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Issues"/>
                <Button Content="Workspace definitions" Tag="6" Click="OnNavigateTask" Classes="authoringAction" AutomationProperties.Name="Navigate Workspace definitions"/>
              </StackPanel></ScrollViewer></Flyout></Button.Flyout>
            </Button></ContentControl>
        </Grid>
        <!-- TabControl supplies retained logical routes and selection events. The template renders only
             the active task; navigation lives in the task bar and overview, with no tab strip. -->
        <vm:TaskPageHost x:Name="WorkspaceTabs" Grid.Row="1" SelectedIndex="8" AutomationProperties.Name="Authoring task workspace">
          <vm:TaskPageHost.Template><ControlTemplate>
            <ContentPresenter Name="ActiveTaskPresenter" Content="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </ControlTemplate></vm:TaskPageHost.Template>
          <TabItem Header="Sequence">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Border Grid.Row="0" IsVisible="{Binding HasSelectedPlan}" Classes="surface" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12" IsEnabled="{Binding CanEditProgramSettings}">
                    <TextBlock x:Name="SequencePlanTitleLabel" Text="Plan title" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding DisplayName}" PlaceholderText="Give this test plan a title" AutomationProperties.Name="Sequence plan title" AutomationProperties.LabeledBy="{Binding #SequencePlanTitleLabel}"/>
                    <TextBlock Grid.Column="2" x:Name="SequenceDeviceFamilyLabel" Text="Device family" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding DutFamily}" PlaceholderText="e.g. Controller board" AutomationProperties.Name="Sequence device family" AutomationProperties.LabeledBy="{Binding #SequenceDeviceFamilyLabel}"/>
                </Grid>
              </Border>
              <Grid x:Name="ProgramLayout" Grid.Row="1" ColumnDefinitions="*,16,400">
                <vm:SequenceEditorView Grid.Column="0"/>
                <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Classes="paneDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize sequence and inspector"/>
                <Border Grid.Column="2" Classes="surface" Padding="16">
                  <Panel>
                    <StackPanel Spacing="12" IsVisible="{Binding EmptyPlanStepHintVisible}">
                      <TextBlock Text="Step editor" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2"/>
                      <TextBlock Text="Add your first step to edit its name, message and settings here." Classes="purpose" TextWrapping="Wrap" AutomationProperties.Name="Empty step editor guidance"/>
                    </StackPanel>
                    <vm:SelectedStepInspectorView IsVisible="{Binding !EmptyPlanStepHintVisible}"/>
                  </Panel>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Instruments"><vm:ProgramSettingsView IsEnabled="{Binding CanEditProgramSettings}"/></TabItem>
          <TabItem Header="Issues"><ContentControl x:Name="IssuesRoute"/></TabItem>
          <TabItem Header="Environment"><vm:WorkspaceEnvironmentView/></TabItem>
          <TabItem Header="Build"><vm:WorkspaceBuildView/></TabItem>
          <TabItem Header="Preview"><ContentControl x:Name="SeparatePreview"/></TabItem>
          <TabItem Header="Definitions"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><vm:WorkspaceDefinitionsView/></ScrollViewer></TabItem>
          <TabItem Header="Operator &amp; reports"><vm:OperatorReportsView IsEnabled="{Binding CanEditProgramSettings}"/></TabItem>
          <TabItem Header="Overview"><vm:WorkspaceOverviewView/></TabItem>
        </vm:TaskPageHost>
      </Grid>
      <Border x:Name="GuidanceHost" IsVisible="False" Classes="surface" Width="380" HorizontalAlignment="Right" Margin="24,8,24,12" Padding="18" BoxShadow="0 4 24 0 #30000000" AutomationProperties.Name="Guidance drawer"/>
    </Panel>
  </DockPanel>
  <Border x:Name="LoadingOverlay" IsVisible="{Binding LoadingBusy}" Background="{DynamicResource AuthoringCanvas}"
      AutomationProperties.Name="Loading workspace or program" ZIndex="10">
    <Border Classes="surface" Padding="28" MaxWidth="480" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding LoadingStage}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
            AutomationProperties.Name="Loading stage" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar IsIndeterminate="True" Height="4" AutomationProperties.Name="Loading progress"/>
        <TextBlock Text="Preparing plans and checking the workspace environment. Large workspaces can take a moment."
            Classes="purpose" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
