<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HardwareTest.Authoring"
        xmlns:host="using:HardwareTest.OpenTap.Host"
        x:Class="HardwareTest.Authoring.MainWindow"
        x:DataType="vm:AuthoringWorkspaceViewModel"
        Title="HardwareTest Authoring"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12">
      <Button Content="Open workspace…" Click="OnOpenWorkspace" />
      <Button Content="New program" Click="OnCreateProgram" />
      <Button Content="Bootstrap" Click="OnBootstrap" />
      <Button Content="Validate" Click="OnValidate" />
      <Button Content="Save sidecar" Click="OnSaveSidecar" />
      <Button Content="Save plan" Click="OnApply" />
      <TextBlock VerticalAlignment="Center" Text="{Binding Status}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom"
               Margin="12,0,12,12"
               Foreground="#C62828"
               Text="{Binding Error}" />
    <Grid ColumnDefinitions="220,*" Margin="12,0,12,12">
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Programs" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Programs}"
                 SelectionChanged="OnProgramSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProgramDraft">
              <TextBlock Text="{Binding PlanId}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <TabControl Grid.Column="1">
        <TabItem Header="Program">
          <Grid ColumnDefinitions="220,260,*" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       FontWeight="SemiBold"
                       Text="Measure"
                       Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       FontWeight="SemiBold"
                       Text="Metric"
                       Margin="12,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                       FontWeight="SemiBold"
                       Text="Preview"
                       Margin="12,0,0,8" />
            <DockPanel Grid.Row="1" Grid.Column="0">
              <TextBlock DockPanel.Dock="Top"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         Text="{Binding MeasureHint}" />
              <ListBox ItemsSource="{Binding MeasureItems}"
                       SelectedIndex="{Binding SelectedMeasureIndex}" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Recipes" />
                <ListBox Height="160"
                         ItemsSource="{Binding Recipes}"
                         SelectionChanged="OnRecipeSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuthoringRecipe">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Add recipe" Click="OnAddRecipe" />
                <TextBlock FontWeight="SemiBold" Text="Selected metric" />
                <TextBox PlaceholderText="Channel key" Text="{Binding ChannelKey}" />
                <TextBox PlaceholderText="Display role" Text="{Binding DisplayRole}" />
                <TextBox PlaceholderText="Y unit" Text="{Binding YUnit}" />
                <TextBox PlaceholderText="Limit low" Text="{Binding LimitLow}" />
                <TextBox PlaceholderText="Limit high" Text="{Binding LimitHigh}" />
                <TextBox PlaceholderText="Threshold" Text="{Binding Threshold}" />
                <TextBlock FontWeight="SemiBold" Text="Formula" />
                <TextBox PlaceholderText="mean(VDC)" Text="{Binding FormulaSource}" />
                <TextBlock Text="{Binding FormulaError}" TextWrapping="Wrap" Foreground="#C62828" />
                <TextBlock FontWeight="SemiBold" Text="Instrument" />
                <TextBox PlaceholderText="VisaAddress" Text="{Binding VisaAddress}" />
                <TextBlock FontWeight="SemiBold" Text="Sidecar" />
                <TextBox PlaceholderText="Display name" Text="{Binding DisplayName}" />
                <TextBox PlaceholderText="DUT family" Text="{Binding DutFamily}" />
                <CheckBox Content="Require serial" IsChecked="{Binding RequireSerial}" />
                <TextBlock FontWeight="SemiBold" Text="Raw step" />
                <TextBlock Text="{Binding RawTypeName}" TextWrapping="Wrap" />
                <TextBox IsReadOnly="True"
                         AcceptsReturn="True"
                         Height="80"
                         Text="{Binding RawXml}" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8" Margin="12,0,0,0">
              <TextBlock Text="{Binding PreviewKind, StringFormat='Tile: {0}'}" />
              <TextBlock Text="{Binding Preview.ChannelKey, StringFormat='Channel: {0}'}" />
              <TextBlock Text="{Binding Preview.DisplayRole, StringFormat='Role: {0}'}" />
              <TextBlock Text="{Binding Preview.YUnit, StringFormat='Unit: {0}'}" />
              <TextBlock Text="{Binding Preview.CannedValue, StringFormat='Canned: {0}'}" />
              <TextBlock Text="Canned samples (not Execute)." />
              <ListBox ItemsSource="{Binding Preview.CannedSamples}" Height="120" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Findings">
          <ListBox ItemsSource="{Binding Findings}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="host:PlanContractFinding">
                <TextBlock Text="{Binding Code}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Workspace">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Workspace.Root}" />
            <TextBlock Text="{Binding Workspace.Manifest.DisplayName}" />
            <TextBlock Text="Open a folder that contains authoring.json. Save plan writes TapPlan + sidecar via IPlanCompiler.Save."
                       TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>
        <TabItem Header="Ship">
          <StackPanel Spacing="8">
            <TextBlock Text="Pack writes a program TapPackage and dist/ship-manifest.json. Shell apps stay bake-time." TextWrapping="Wrap" />
            <Button Content="Pack…" Click="OnPack" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
