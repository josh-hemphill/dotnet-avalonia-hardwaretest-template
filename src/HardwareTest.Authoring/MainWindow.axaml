<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.MainWindow" x:DataType="vm:AuthoringWorkspaceViewModel"
    Title="HardwareTest Authoring" Width="1280" Height="800" MinWidth="960" MinHeight="600">
  <Window.Styles>
    <Style Selector="Button.authoringAction">
      <Setter Property="ContentTemplate" Value="{x:Static vm:AuthoringActionLabels.WrappedText}"/>
    </Style>
  </Window.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="LifecycleFocusTarget" Content="Open workspace…" Click="OnOpenWorkspace"
            ToolTip.Tip="Open a folder that contains authoring.json" AutomationProperties.Name="Open workspace"
            Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Bootstrap" Click="OnBootstrap" IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Install Editor packs into this workspace’s isolated OpenTAP home (offline)"
            AutomationProperties.Name="Bootstrap OpenTAP home" Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Undo catalog" Click="OnUndoWorkspace" IsEnabled="{Binding CanUndoWorkspace}"
            AutomationProperties.Name="Undo workspace catalog" ToolTip.Tip="{Binding WorkspaceHistoryHint}"
            Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Redo catalog" Click="OnRedoWorkspace" IsEnabled="{Binding CanRedoWorkspace}"
            AutomationProperties.Name="Redo workspace catalog" ToolTip.Tip="{Binding WorkspaceHistoryHint}"
            Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Save sidecar" Click="OnSaveSidecar" IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Save sidecar settings and authoring source without compiling the TapPlan."
            AutomationProperties.Name="Save sidecar" Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Save draft / compile" Classes="accent authoringAction" Click="OnApply"
            IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Save authoring source, including incomplete values; export compiled files when ready"
            AutomationProperties.Name="Save plan" Margin="0,0,6,4"/>
        <Button Content="Undo" Click="OnUndo" IsEnabled="{Binding CanUndo}"
            AutomationProperties.Name="Undo selected program" ToolTip.Tip="Undo the selected program's last edit"
            Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Redo" Click="OnRedo" IsEnabled="{Binding CanRedo}"
            AutomationProperties.Name="Redo selected program" ToolTip.Tip="Redo the selected program's last edit"
            Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Save all" Click="OnSaveAll" IsEnabled="{Binding HasWorkspace}"
            AutomationProperties.Name="Save all" Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="Validate" Click="OnValidate" IsEnabled="{Binding HasWorkspace}"
            ToolTip.Tip="Run PlanContractValidator --strict on TapPlans in this workspace"
            AutomationProperties.Name="Validate workspace" Margin="0,0,6,4" Classes="authoringAction"/>
        <Button Content="{Binding SettingsTitle}" Click="OnOpenSettings" ToolTip.Tip="{Binding SettingsPurpose}"
            AutomationProperties.Name="Open settings" Margin="0,0,6,4" Classes="authoringAction"/>
      </WrapPanel>
      <Grid IsVisible="{Binding OperationBusy}" ColumnDefinitions="Auto,*,Auto">
        <Button Content="Cancel operation" Click="OnCancelOperation" IsEnabled="{Binding OperationBusy}"
            AutomationProperties.Name="Cancel authoring operation" Grid.Column="0" Margin="0,0,8,0"
            Classes="authoringAction"/>
        <TextBlock Text="{Binding OperationStage}" VerticalAlignment="Center" MaxWidth="520"
            TextTrimming="CharacterEllipsis" Grid.Column="1" Margin="0,0,8,0"/>
        <TextBlock Text="Operation logs" VerticalAlignment="Center" ToolTip.Tip="{Binding OperationLogText}"
            AutomationProperties.Name="Authoring operation logs" Grid.Column="2" Margin="0,0,8,0"
            TextTrimming="CharacterEllipsis"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Text="{Binding Status}"
            ToolTip.Tip="{Binding OperationLogText}" AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Authoring status" Grid.Column="0" Margin="0,0,8,0"
            TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Unsaved changes" IsVisible="{Binding HasUnsavedChanges}" VerticalAlignment="Center"
            FontWeight="SemiBold" AutomationProperties.Name="Unsaved changes" Grid.Column="1" Margin="0,0,8,0"
            TextTrimming="CharacterEllipsis"/>
      </Grid>
    </StackPanel>
    <ScrollViewer DockPanel.Dock="Top" Margin="12,0,12,8" MaxHeight="40" HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Save all result feedback">
      <ItemsControl ItemsSource="{Binding SaveAllResults}" AutomationProperties.Name="Save all results">
        <ItemsControl.Styles>
          <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
          </Style>
        </ItemsControl.Styles>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock DockPanel.Dock="Top" Margin="12,0,12,8" Text="{Binding ValidationScope}"
        IsVisible="{Binding HasWorkspace}" TextWrapping="Wrap"/>
    <ScrollViewer DockPanel.Dock="Bottom" Margin="12,0,12,12" MaxHeight="32" HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        AutomationProperties.Name="Authoring error feedback">
      <TextBlock Foreground="#C62828" TextWrapping="Wrap"
          IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          Text="{Binding Error, StringFormat='Error: {0}'}" ToolTip.Tip="{Binding OperationLogText}"
          AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Authoring error"/>
    </ScrollViewer>
    <Panel>
      <Border IsVisible="{Binding !HasWorkspace}" Margin="12,0,12,12" Padding="24" HorizontalAlignment="Center"
          VerticalAlignment="Center" MaxWidth="520">
        <StackPanel Spacing="12">
          <TextBlock Text="Open a workspace to begin" FontSize="22" FontWeight="SemiBold"
              AutomationProperties.HeadingLevel="1"/>
          <TextBlock
              Text="Choose a folder containing authoring.json to edit programs, preview measurements, and validate saved plans."
              TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open workspace…" Click="OnOpenWorkspace"
                AutomationProperties.Name="Open workspace from welcome" Classes="authoringAction"/>
            <Button Content="{Binding LastWorkspaceOffer}" Click="OnOpenLastWorkspace"
                IsVisible="{Binding CanOfferLastWorkspace}" ToolTip.Tip="{Binding LastWorkspacePath}"
                AutomationProperties.Name="Open last workspace from welcome" Classes="authoringAction"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="180,*" Margin="12,0,12,12" IsVisible="{Binding HasWorkspace}">
        <vm:ProgramsRailView Grid.Column="0"/>
        <TabControl x:Name="WorkspaceTabs" Grid.Column="1">
          <TabItem Header="Program" AutomationProperties.Name="Program tab">
            <Grid RowDefinitions="Auto,*" x:Name="ProgramLayout">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="0"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                <TextBlock x:Name="SequenceHeading" FontWeight="SemiBold" Text="{Binding SequenceTitle}"
                    AutomationProperties.HeadingLevel="2" TextWrapping="Wrap" ToolTip.Tip="{Binding SequencePurpose}"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                <TextBlock x:Name="InspectorHeading" FontWeight="SemiBold" Text="{Binding InspectorTitle}"
                    AutomationProperties.HeadingLevel="2" TextWrapping="Wrap" ToolTip.Tip="{Binding InspectorPurpose}"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" x:Name="DockedPreviewHeading">
                <TextBlock x:Name="PreviewHeading" FontWeight="SemiBold" Text="{Binding PreviewTitle}"
                    AutomationProperties.HeadingLevel="2" TextWrapping="Wrap" ToolTip.Tip="{Binding PreviewPurpose}"/>
              </StackPanel>
              <vm:SequenceEditorView Grid.Row="1" Grid.Column="0"/>
              <vm:SelectedStepInspectorView Grid.Row="1" Grid.Column="2"/>
              <ContentControl Grid.Row="1" Grid.Column="4" x:Name="DockedPreview" Margin="8,0,0,0"/>
            </Grid>
          </TabItem>
          <TabItem Header="Hardware" AutomationProperties.Name="Program settings tab">
            <vm:ProgramSettingsView IsEnabled="{Binding CanEditProgramSettings}"/>
          </TabItem>
          <TabItem Header="Issues" AutomationProperties.Name="Findings tab">
            <vm:WorkspaceIssuesView/>
          </TabItem>
          <TabItem Header="Environment" AutomationProperties.Name="Workspace tab">
            <vm:WorkspaceEnvironmentView/>
          </TabItem>
          <TabItem Header="Build" AutomationProperties.Name="Ship tab">
            <vm:WorkspaceBuildView/>
          </TabItem>
          <TabItem Header="Preview" AutomationProperties.Name="Preview tab">
            <ContentControl x:Name="SeparatePreview"/>
          </TabItem>
        </TabControl>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
