<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host" x:Class="HardwareTest.Authoring.WorkspacePreviewView" x:DataType="vm:AuthoringWorkspaceViewModel">
    <Grid x:Name="PreviewLayout" RowDefinitions="Auto,Auto,*" RowSpacing="8" AutomationProperties.Name="Preview content">
      <ScrollViewer x:Name="SourceDetailsViewport" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ClipToBounds="True" AutomationProperties.Name="Data source details viewport">
        <Border x:Name="SourceFrame" Classes="surface" Padding="4">
          <StackPanel Spacing="4">
            <WrapPanel x:Name="SourceActions">
              <TextBlock Text="Preview data" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.HeadingLevel="3" Classes="sectionTitle"/>
              <Button Content="Example" Click="OnUseExampleData" ToolTip.Tip="Use example data" AutomationProperties.Name="Use example data" Classes="authoringAction" Margin="0,0,8,0"/>
              <Button Content="Import" Click="OnImportRecording" ToolTip.Tip="Import recording" IsEnabled="{Binding CanImportRecording}" AutomationProperties.Name="Import recording" Classes="authoringAction primaryAction" Margin="0,0,8,0"/>
              <Button Content="Folder" Click="OnOpenRecordingFolder" ToolTip.Tip="Open recordings folder" IsEnabled="{Binding HasWorkspace}" AutomationProperties.Name="Open recordings folder" Classes="authoringAction" Margin="0,0,8,0"/>
              <Button Content="Refresh" Click="OnRefreshRecordings" ToolTip.Tip="Reload recordings copied or changed outside this app" IsEnabled="{Binding HasWorkspace}" AutomationProperties.Name="Refresh recordings" Classes="authoringAction" Margin="0,0,8,0"/>
            </WrapPanel>
            <Expander x:Name="SourceDetailsDisclosure" HorizontalContentAlignment="Stretch" Classes="inspectorSection" AutomationProperties.Name="Preview data source details">
              <Expander.Header><TextBlock Text="{Binding PreviewDataSourceLabel}" TextTrimming="CharacterEllipsis" MaxWidth="640" ToolTip.Tip="{Binding DataSourceDetails}"/></Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DataSourceDetails}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RecordingEmptyState}" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </ScrollViewer>
      <StackPanel x:Name="RecordingRows" Grid.Row="1" Spacing="8" Margin="0" IsVisible="{Binding HasRecordings}">
        <Expander x:Name="RecordingsDisclosure" Header="{Binding DatasetItems.Count, StringFormat='Recordings ({0})'}" HorizontalContentAlignment="Stretch" Classes="inspectorSection" AutomationProperties.Name="Choose a recording">
        <ListBox Height="80" ItemsSource="{Binding DatasetItems}" SelectedIndex="{Binding SelectedDatasetIndex}" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Recordings"/>
        </Expander>
      </StackPanel>
      <Grid x:Name="BoardRegion" RowDefinitions="Auto,*" RowSpacing="8" Grid.Row="2">
        <TextBlock x:Name="BoardHeading" Text="Operator board" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
        <vm:OperatorPreviewPane x:Name="BoardPane" Grid.Row="1"/>
      </Grid>
    </Grid>
</UserControl>
