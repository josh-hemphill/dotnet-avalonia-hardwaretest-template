<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" x:Class="HardwareTest.Authoring.WorkspacePreviewView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <Grid x:Name="PreviewLayout" RowDefinitions="Auto,*" RowSpacing="8" AutomationProperties.Name="Preview content">
    <Border x:Name="SourceFrame" Classes="surface" Padding="4">
      <StackPanel Spacing="4">
        <WrapPanel x:Name="SourceActions">
          <TextBlock Text="{Binding PreviewDataSourceLabel}" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,12,4"
              FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding DataSourceDetails}" AutomationProperties.HeadingLevel="3" AutomationProperties.Name="{Binding PreviewDataSourceLabel}"/>
          <Button Content="Example" Click="OnUseExampleData" ToolTip.Tip="Use example data" AutomationProperties.Name="Use example data" Classes="authoringAction" Margin="0,0,8,4"/>
          <Button Content="Import" Click="OnImportRecording" ToolTip.Tip="Import recording" IsEnabled="{Binding CanImportRecording}" AutomationProperties.Name="Import recording" Classes="authoringAction primaryAction" Margin="0,0,8,4"/>
          <Button Content="Folder" Click="OnOpenRecordingFolder" ToolTip.Tip="Open recordings folder" IsEnabled="{Binding HasWorkspace}" AutomationProperties.Name="Open recordings folder" Classes="authoringAction" Margin="0,0,8,4"/>
          <Button Content="Refresh" Click="OnRefreshRecordings" ToolTip.Tip="Reload recordings copied or changed outside this app" IsEnabled="{Binding HasWorkspace}" AutomationProperties.Name="Refresh recordings" Classes="authoringAction" Margin="0,0,8,4"/>
          <Button Content="Source details" Click="OnShowSourceDetails" AutomationProperties.Name="Preview data source details" Classes="authoringAction" Margin="0,0,8,4"/>
          <Button Content="{Binding DatasetItems.Count, StringFormat='Recordings ({0})'}" IsVisible="{Binding HasRecordings}" Click="OnChooseRecording" AutomationProperties.Name="Choose a recording" Classes="authoringAction" Margin="0,0,8,4"/>
        </WrapPanel>
        <TextBlock Text="Preview only; no hardware execution." Classes="purpose" TextWrapping="Wrap" AutomationProperties.Name="Preview does not execute hardware"/>
      </StackPanel>
    </Border>
    <Grid x:Name="BoardRegion" RowDefinitions="Auto,*" RowSpacing="8" Grid.Row="1">
      <TextBlock x:Name="BoardHeading" Text="Operator board" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
      <vm:OperatorPreviewPane x:Name="BoardPane" Grid.Row="1"/>
    </Grid>
  </Grid>
</UserControl>
