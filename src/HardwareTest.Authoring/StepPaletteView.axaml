<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HardwareTest.Authoring" x:Class="HardwareTest.Authoring.StepPaletteView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="24">
    <StackPanel Spacing="10"><TextBlock Text="Add a step" Classes="routeTitle" AutomationProperties.HeadingLevel="1"/><TextBox x:Name="SearchBox" Text="{Binding RecipeSearch}" PlaceholderText="Search measurements, checks, operator actions or flow" AutomationProperties.Name="Search sequence palette"/></StackPanel>
    <ListBox IsVisible="{Binding !NoMatchingRecipes}" KeyboardNavigation.TabNavigation="Once" Focusable="True" Grid.Row="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" Classes="authoringList" AutomationProperties.Name="Recipe" MinHeight="80">
      <ListBox.ItemTemplate><DataTemplate x:DataType="vm:AuthoringRecipe"><StackPanel Spacing="4"><TextBlock Text="{Binding Category}" Classes="eyebrow"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="purpose"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="1" IsVisible="{Binding NoMatchingRecipes}" Classes="surface taskSection">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <TextBlock Text="No matching steps" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.Name="No matching steps" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="Try a shorter search, or clear it to browse all steps." Classes="purpose" TextWrapping="Wrap"/>
          <Button Content="Clear search" Click="OnClearSearch" HorizontalAlignment="Left" Classes="authoringAction" AutomationProperties.Name="Clear step search"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="12">
      <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Step insertion details">
        <StackPanel Spacing="8"><TextBlock Text="{Binding SequenceOperationTarget}" TextWrapping="Wrap"/><TextBlock Text="Insertion point"/><ComboBox ItemsSource="{Binding InsertionPositions}" SelectedItem="{Binding InsertionPosition}" HorizontalAlignment="Stretch" AutomationProperties.Name="Insertion point"/><TextBlock Text="{Binding SelectedRecipePrerequisites}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource AuthoringError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button IsCancel="True" Content="Cancel" Click="OnCancel" Classes="authoringAction" AutomationProperties.Name="Cancel add step"/><Button IsDefault="True" Content="Insert step" Click="OnInsert" IsEnabled="{Binding CanInsertRecipe}" Classes="authoringAction primaryAction" AutomationProperties.Name="Add recipe"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>
