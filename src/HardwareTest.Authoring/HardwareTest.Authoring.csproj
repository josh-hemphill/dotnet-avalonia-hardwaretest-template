<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HardwareTest.Authoring</RootNamespace>
    <Description>Engineer workstation app for metric-first OpenTAP plan authoring</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>false</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
    <InstallCreatedOpenTapPackage>false</InstallCreatedOpenTapPackage>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HardwareTest.Authoring.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HardwareTest.Authoring.Core\HardwareTest.Authoring.Core.csproj" />
    <ProjectReference Include="..\HardwareTest.Widgets\HardwareTest.Widgets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTAP" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- OpenTAP's SDK copies its payload at build time but does not publish it. -->
  <Target Name="PublishAuthoringOpenTapRuntime" AfterTargets="Publish">
    <ItemGroup>
      <AuthoringOpenTapRuntime Include="$(OpenTapRuntimeDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthoringOpenTapRuntime)"
          DestinationFiles="@(AuthoringOpenTapRuntime->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
