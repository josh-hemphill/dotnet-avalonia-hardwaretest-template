<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host" x:Class="HardwareTest.Authoring.WorkspaceEnvironmentView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Classes="routeBody">
      <TextBlock Text="Prepare your authoring environment" Classes="routeTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
      <TextBlock Text="Check readiness, prepare packages, then return to your test plan." Classes="purpose" TextWrapping="Wrap"/>
      <Border Classes="surface taskSection">
        <StackPanel Spacing="12">
          <TextBlock Text="Selected home and readiness" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
          <TextBlock Text="OpenTAP home" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding AuthoringHomeText}" TextWrapping="Wrap" AutomationProperties.Name="Selected authoring home"/>

          <vm:ResponsiveTaskGrid>
            <StackPanel Spacing="8">
              <TextBlock Text="Physical instruments" Classes="sectionTitle"/>
              <TextBlock Text="{Binding EnvironmentLibraryReadiness.State}" FontWeight="SemiBold" AutomationProperties.Name="Instrument Components readiness"/>
              <TextBlock Text="{Binding EnvironmentLibraryReadiness.Summary}" TextWrapping="Wrap" AutomationProperties.Name="Instrument Components readiness reason"/>
              <TextBlock Text="Next action" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding EnvironmentLibraryReadiness.NextStep}" TextWrapping="Wrap" AutomationProperties.Name="Instrument Components next action"/>
              <Expander Header="Diagnostic details" HorizontalContentAlignment="Stretch" Classes="inspectorSection" AutomationProperties.Name="Instrument Components diagnostic details">
                <TextBlock Text="{Binding EnvironmentLibraryReadiness.Details}" TextWrapping="Wrap"/>
              </Expander>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Hardware execution" Classes="sectionTitle"/>
              <TextBlock Text="{Binding EnvironmentExecutionReadiness.State}" FontWeight="SemiBold" AutomationProperties.Name="Standalone VISA readiness"/>
              <TextBlock Text="{Binding EnvironmentExecutionReadiness.Summary}" TextWrapping="Wrap" AutomationProperties.Name="Standalone VISA readiness reason"/>
              <TextBlock Text="Next action" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding EnvironmentExecutionReadiness.NextStep}" TextWrapping="Wrap" AutomationProperties.Name="Standalone VISA next action"/>
              <Expander Header="Diagnostic details" HorizontalContentAlignment="Stretch" Classes="inspectorSection" AutomationProperties.Name="Standalone VISA diagnostic details">
                <TextBlock Text="{Binding EnvironmentExecutionReadiness.Details}" TextWrapping="Wrap"/>
              </Expander>
            </StackPanel>
          </vm:ResponsiveTaskGrid>
        </StackPanel>
      </Border>
      <Border Classes="surface taskSection">
        <StackPanel Spacing="12">
          <TextBlock Text="Prepare in three steps" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
          <TextBlock Text="1. Declare the instrument library if this plan uses physical hardware." TextWrapping="Wrap"/>
          <TextBlock Text="2. Save All to persist the requirements." TextWrapping="Wrap"/>
          <TextBlock Text="3. Prepare packages. Compatible installed packages are reused; bundled packages are installed first." TextWrapping="Wrap"/>
          <TextBlock Text="{Binding EnvironmentRecoveryText}" Classes="purpose" TextWrapping="Wrap"/>
          <CheckBox Content="Download missing required packages during preparation" IsChecked="{Binding DownloadRequiredPackages}" IsEnabled="{Binding PackageDownloadSettingsEditable}" AutomationProperties.Name="Automatically download required packages"/>
          <TextBlock Text="Optional packages are not downloaded. Downloads use the repository below and install only into the selected authoring home." Classes="purpose" TextWrapping="Wrap"/>
          <TextBlock Text="Package repository (HTTPS)" FontWeight="SemiBold"/>
          <TextBox Text="{Binding PackageRepositoryUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PackageDownloadSettingsEditable}" AutomationProperties.Name="Environment package repository URL"/>
          <TextBlock Text="{Binding PackageRepositoryError}" IsVisible="{Binding PackageRepositoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource AuthoringError}" TextWrapping="Wrap" AutomationProperties.Name="Environment repository validation" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Spacing="8" AutomationProperties.Name="Package sourcing guidance">
            <TextBlock Text="Manual download fallback" FontWeight="SemiBold"/>
            <TextBlock Text="If a download fails or your network is offline, obtain a .TapPackage or .zip from the package source, match the required version below, then choose Import offline package. You can import packages one at a time." TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Content="Open package repository" Click="OnOpenPackageRepository" Classes="authoringAction" AutomationProperties.Name="Open package repository" Margin="0,0,8,8"/>
              <Button Content="Open Instrument Components releases" Click="OnOpenLibraryReleases" Classes="authoringAction" AutomationProperties.Name="Open Instrument Components releases" Margin="0,0,8,8"/>
              <Button Content="Copy package requirements" Click="OnCopyPackageRequirements" Classes="authoringAction" AutomationProperties.Name="Copy package requirements" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="Use Instrument Components releases for the supported instrument library. For private packages, request matching archives from your team or publisher. Source links open your browser." Classes="purpose" TextWrapping="Wrap"/>
            <TextBlock x:Name="PackageSourceFeedback" TextWrapping="Wrap" AutomationProperties.Name="Package sourcing result" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <WrapPanel>
            <Button Content="Declare Instrument Components dependency" Click="OnDeclareLibrary" IsEnabled="{Binding CanDeclareLibraryDependency}" AutomationProperties.Name="Declare Instrument Components dependency" Classes="authoringAction" Margin="0,0,8,8"/>
            <Button Content="Resume New test plan" Click="OnResumeInitialization" IsEnabled="{Binding CanInitializePlan}" AutomationProperties.Name="Resume New test plan" Classes="authoringAction" Margin="0,0,8,8"/>
            <Button Content="Prepare authoring environment" Click="OnPrepareEnvironment" IsEnabled="{Binding !OperationBusy}" AutomationProperties.Name="Prepare selected authoring environment" Classes="authoringAction primaryAction" Margin="0,0,8,8"/>
            <Button Content="Download missing packages now" Click="OnDownloadPackages" IsEnabled="{Binding !OperationBusy}" AutomationProperties.Name="Download missing required packages" Classes="authoringAction" Margin="0,0,8,8"/>
            <Button Content="Import offline package…" Click="OnImportOfflinePackage" IsEnabled="{Binding !OperationBusy}" AutomationProperties.Name="Import offline authoring package" Classes="authoringAction" Margin="0,0,8,8"/>
            <Button Content="Cancel preparation" Click="OnCancelPreparation" IsVisible="{Binding OperationBusy}" Classes="authoringAction" AutomationProperties.Name="Cancel environment preparation" Margin="0,0,8,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding OperationStage}" IsVisible="{Binding OperationBusy}" TextWrapping="Wrap" AutomationProperties.Name="Environment preparation progress" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource AuthoringError}" TextWrapping="Wrap" AutomationProperties.Name="Environment preparation error" AutomationProperties.LiveSetting="Assertive"/>
          <TextBlock Text="Required and installed package versions" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding EnvironmentPackages}" AutomationProperties.Name="Environment package requirements">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AuthoringPackageRequirement">
                <Border BorderBrush="{DynamicResource AuthoringLine}" BorderThickness="0,0,0,1" Padding="0,10">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Package}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold"/>
                    </Grid>
                    <WrapPanel>
                      <TextBlock Text="{Binding RequiredVersion, StringFormat='Required: {0}'}" Margin="0,0,16,0"/>
                      <TextBlock Text="{Binding InstalledVersion, StringFormat='Installed: {0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="Optional" IsVisible="{Binding Optional}" Margin="16,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap" Classes="purpose"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Expander Header="Installed packages and runtime details" HorizontalContentAlignment="Stretch" Classes="inspectorSection">
        <StackPanel Spacing="12">
          <TextBlock Text="Installed packages and runtime" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
          <TextBlock Text="Installed packages in selected home" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding PackPreview.AuthoringHomePackages}" AutomationProperties.Name="Environment installed packages">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OpenTapEnvironmentLine">
                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Runtime prerequisites" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding EnvironmentRuntimeFiles}" AutomationProperties.Name="Authoring runtime prerequisites"/>
        </StackPanel>
      </Expander>
      <Border Classes="surface taskSection">
        <StackPanel Spacing="12">
          <TextBlock Text="Workspace recovery" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
          <Expander Header="Draft recovery and reconciliation" AutomationProperties.Name="Draft recovery">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DraftStateSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
              <WrapPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding RecoverableProgramIds}" SelectedItem="{Binding SelectedRecoveryPlanId}" MinWidth="100" AutomationProperties.Name="Recovery program"/>
                <Button Content="Recover selected draft" Click="OnAcceptRecovery" Classes="authoringAction" Margin="0,0,8,8"/>
                <Button Content="Discard selected recovery" Click="OnDiscardRecovery" Classes="authoringAction" Margin="0,0,8,8"/>
                <Button Content="Import external compiled edits" Click="OnImportCompiled" Classes="authoringAction" Margin="0,0,8,8"/>
                <Button Content="Retain source for export" Click="OnRetainSource" Classes="authoringAction" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Expander Header="Workspace and build declarations" HorizontalContentAlignment="Stretch" Classes="inspectorSection">
        <StackPanel Spacing="12">
          <TextBlock Text="Workspace and build declarations" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
          <TextBlock Text="{Binding Workspace.Root}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Workspace.Manifest.DisplayName}" TextWrapping="Wrap"/>
          <TextBlock Text="Open a folder containing authoring.json. Save draft preserves incomplete edits; ready plans also export compiled files." TextWrapping="Wrap"/>
          <TextBlock FontWeight="SemiBold" Text="Declared plugins" TextWrapping="Wrap"/>
          <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasDeclaredPlugins}" Text="No pluginProjects in authoring.json. Extra TapPackages would copy into dist on Pack."/>
          <ItemsControl ItemsSource="{Binding PackPreview.PluginProjects}" AutomationProperties.Name="Declared plugin projects">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackDeclaredProjectLine">
                <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock FontWeight="SemiBold" Text="Declared shell apps (bake-time)" TextWrapping="Wrap"/>
          <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasDeclaredShellApps}" Text="No shellAppProjects in authoring.json. Pack would publish each csproj into dist/shell-apps/{id} and label it bake-time."/>
          <ItemsControl ItemsSource="{Binding PackPreview.ShellAppProjects}" AutomationProperties.Name="Declared shell-app projects">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackDeclaredProjectLine">
                <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
