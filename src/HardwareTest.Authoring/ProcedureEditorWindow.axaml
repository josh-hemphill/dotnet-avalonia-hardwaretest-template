<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTest.Authoring.ProcedureEditorWindow"
        Title="Procedure editor" Width="840" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <TextBlock x:Name="ProcedureTitle" Classes="routeTitle" AutomationProperties.HeadingLevel="1"/>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
      <RadioButton x:Name="StepsMode" GroupName="ProcedurePanels" IsChecked="True" Content="Procedure" IsCheckedChanged="OnModeChanged"/>
      <RadioButton x:Name="DataMode" Grid.Column="1" GroupName="ProcedurePanels" Content="Data tables" IsCheckedChanged="OnModeChanged"/>
      <TextBox Grid.Column="2" x:Name="ProcedureSearch" PlaceholderText="Search names, types or values" TextChanged="OnSearchChanged"
               AutomationProperties.Name="Search procedure or data"/>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="2*,8,3*">
      <ListBox x:Name="ProcedureEntries" SelectionChanged="OnEntryChanged"
               AutomationProperties.Name="Procedure items" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles><Style Selector="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ListBox.Styles>
      </ListBox>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize procedure list"/>
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,0,6,0" Spacing="10">
          <TextBlock x:Name="ItemTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
          <TextBlock x:Name="ItemDetail" TextWrapping="Wrap" AutomationProperties.Name="Selected item details"/>
          <WrapPanel x:Name="StepActions" ItemSpacing="6" LineSpacing="6">
            <Button x:Name="ToggleChildren" Content="Collapse children" Click="OnToggleChildren"/>
            <Button x:Name="MoveEarlier" Content="Move up" Click="OnMoveUp"/>
            <Button x:Name="MoveLater" Content="Move down" Click="OnMoveDown"/>
            <Button x:Name="PreviewOperator" Content="Preview operator prompt" Click="OnPreview"/>
          </WrapPanel>
          <Grid x:Name="AddActions" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="ChildType" HorizontalAlignment="Stretch" PlaceholderText="Choose a step type" AutomationProperties.Name="Step type to add"/>
            <Button Grid.Column="1" Content="Add child" Click="OnAddChild"/>
          </Grid>
          <Grid x:Name="DuplicateActions" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="NewDataId" PlaceholderText="New row ID" AutomationProperties.Name="New row ID"/>
            <Button Grid.Column="1" Content="Duplicate row" Click="OnDuplicate"/>
          </Grid>
          <Button x:Name="RemoveItem" Content="Remove row" Click="OnRemove"/>
          <StackPanel x:Name="ItemFields" Spacing="8"/>
          <TextBlock x:Name="RelatedHeading" Text="Related steps and data" FontWeight="SemiBold" AutomationProperties.HeadingLevel="3"/>
          <StackPanel x:Name="RelatedItems" Spacing="4"/>
          <TextBlock x:Name="RecordingRows" TextWrapping="Wrap" AutomationProperties.Name="Recorded results and proposed verdicts"/>
          <StackPanel x:Name="PromptPreview" Spacing="8" IsVisible="False"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ProcedureStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Procedure editor status"/>
      </ScrollViewer>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button x:Name="ReviewDraft" Content="Review changes" Click="OnReview"/>
        <Button x:Name="CloseProcedure" Content="Close" Click="OnCancel"/>
        <Button x:Name="ApplyProcedure" Content="Apply to draft" Classes="accent" Click="OnApply"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
