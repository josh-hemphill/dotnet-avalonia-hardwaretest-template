<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Authoring"
             x:Class="HardwareTest.Authoring.SettingsView"
             x:DataType="vm:AuthoringWorkspaceViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="640">
      <TextBlock FontWeight="SemiBold"
                 Text="{Binding SettingsTitle}"
                 AutomationProperties.HeadingLevel="1" />
      <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding SettingsPurpose}" />
      <TextBlock Opacity="0.85"
                 TextWrapping="Wrap"
                 IsVisible="{Binding PreferencesReadOnly}"
                 Text="This preferences file uses a newer schema. Settings are read-only until you upgrade Authoring."
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="Preferences read-only warning" />

      <TextBlock x:Name="ThemeLabel" Text="Theme" />
      <ComboBox ItemsSource="{Binding ThemeOptions}"
                SelectedItem="{Binding ThemePreference}"
                IsEnabled="{Binding PreferencesEditable}"
                AutomationProperties.Name="Theme"
                AutomationProperties.LabeledBy="{Binding #ThemeLabel}"
                ToolTip.Tip="System follows the OS. Light and Dark apply only to Authoring chrome, not operator appliance settings." />

      <CheckBox Content="Show raw step XML"
                IsChecked="{Binding ShowRawStepXml}"
                IsEnabled="{Binding PreferencesEditable}"
                ToolTip.Tip="When off, Raw TUI steps still appear in the sequence but the XML pane is hidden." />

      <TextBlock x:Name="OpenTapHomeLabel" Text="OpenTAP home override" />
      <TextBox Text="{Binding OpenTapHomeOverride, UpdateSourceTrigger=LostFocus}"
               IsEnabled="{Binding PreferencesEditable}"
               PlaceholderText="Leave empty to use {workspace}/.authoring/opentap"
               AutomationProperties.Name="OpenTAP home override"
               AutomationProperties.LabeledBy="{Binding #OpenTapHomeLabel}"
               ToolTip.Tip="Used when Bootstrap has no --opentap-home / HomeDirectory. Headless --opentap-home still wins." />

      <TextBlock x:Name="LastWorkspaceLabel" Text="Last workspace" />
      <TextBox Text="{Binding LastWorkspacePath, Mode=OneWay}"
               IsReadOnly="True"
               AutomationProperties.Name="Last workspace"
               AutomationProperties.LabeledBy="{Binding #LastWorkspaceLabel}"
               ToolTip.Tip="Remembered when you open a workspace. Offered on the Programs rail; never auto-opened." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
