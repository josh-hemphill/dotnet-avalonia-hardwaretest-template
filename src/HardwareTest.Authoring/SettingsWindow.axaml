<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HardwareTest.Authoring"
        x:Class="HardwareTest.Authoring.SettingsWindow"
        x:DataType="vm:AuthoringWorkspaceViewModel"
        Title="{Binding SettingsTitle}"
        Width="520"
        MinWidth="400"
        MinHeight="360"
        Height="640"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <vm:SettingsView/>
    <Button Grid.Row="1" Content="Close" Click="OnClose" Classes="authoringAction"
            HorizontalAlignment="Right" Margin="0,12,0,0" AutomationProperties.Name="Close settings"/>
  </Grid>
</Window>
