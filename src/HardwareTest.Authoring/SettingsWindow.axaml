<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HardwareTest.Authoring"
        x:Class="HardwareTest.Authoring.SettingsWindow"
        x:DataType="vm:AuthoringWorkspaceViewModel"
        Title="{Binding SettingsTitle}"
        Width="520"
        MinWidth="400"
        MinHeight="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <vm:SettingsView Margin="16" />
</Window>
