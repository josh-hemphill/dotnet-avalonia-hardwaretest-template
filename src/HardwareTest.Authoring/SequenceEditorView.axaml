<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.SequenceEditorView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" AutomationProperties.Name="Sequence editor">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="RUN ORDER" Classes="eyebrow"/><TextBlock Text="Select a step or section to configure it" Classes="purpose" TextWrapping="Wrap"/></StackPanel>
      <Button Grid.Column="1" x:Name="SectionActionsButton" Content="Sections ▾" Classes="authoringAction" AutomationProperties.Name="Manage test sections" IsEnabled="{Binding CanEditSequence}">
        <Button.Flyout><Flyout><ScrollViewer Width="300" MaxHeight="360" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Classes="workspaceMenu">
          <TextBlock Text="Device test sections" Classes="sectionTitle"/>
          <TextBlock Text="Group tests by device system. Setup stays first and Cleanup stays last." Classes="purpose" TextWrapping="Wrap"/>
          <TextBlock x:Name="NewSectionLabel" Text="New section name"/>
          <TextBox Text="{Binding NewSectionName}" PlaceholderText="Power supply, communications…" AutomationProperties.Name="New section name" AutomationProperties.LabeledBy="{Binding #NewSectionLabel}"/>
          <Button Content="Add section" Click="OnAddSection" AutomationProperties.Name="Add section" Classes="authoringAction"/>
          <Button Content="Expand all sections" Click="OnExpandAllSections" AutomationProperties.Name="Expand all sections" Classes="authoringAction"/>
          <TextBlock Text="Jump to phase" Classes="sectionTitle"/>
          <WrapPanel>
            <Button Content="Setup" Click="OnJumpSection" Tag="Setup" Classes="authoringAction" AutomationProperties.Name="Manage Setup section"/>
            <Button Content="Measure" Click="OnJumpSection" Tag="Measure" Classes="authoringAction" AutomationProperties.Name="Manage Measure section"/>
            <Button Content="Cleanup" Click="OnJumpSection" Tag="Cleanup" Classes="authoringAction" AutomationProperties.Name="Manage Cleanup section"/>
          </WrapPanel>
        </StackPanel></ScrollViewer></Flyout></Button.Flyout>
      </Button>
      <Button Grid.Column="2" x:Name="SequenceActionsButton" Content="+ Add step" Click="OnOpenPalette" Classes="authoringAction primaryAction" AutomationProperties.Name="Add step" IsEnabled="{Binding CanEditProgramSettings}"/>
    </Grid>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding NeedsFirstPlan}" HorizontalScrollBarVisibility="Disabled">
      <Border Classes="surface taskSection"><StackPanel Spacing="12">
        <TextBlock Text="Create your first test plan" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
        <TextBlock Text="This workspace has no test plans yet. Create a plan to give it a title, add steps and configure instruments." Classes="purpose" TextWrapping="Wrap"/>
        <Button Content="Create test plan" Click="OnCreatePlan" IsEnabled="{Binding CanInitializePlan}" Classes="authoringAction primaryAction" AutomationProperties.Name="Create first test plan from sequence" HorizontalAlignment="Left"/>
      </StackPanel></Border>
    </ScrollViewer>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSequenceEmpty}" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Empty plan getting started">
      <Border Classes="surface taskSection"><StackPanel Spacing="12">
        <TextBlock Text="Add your first step" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
        <TextBlock Text="Name your plan above, then choose a step. Operator prompts and other steps without hardware can be added immediately. Configure an instrument before adding hardware measurements." Classes="purpose" TextWrapping="Wrap"/>
        <WrapPanel>
          <Button Content="Add your first step" Click="OnOpenPalette" IsEnabled="{Binding CanEditSequence}" Classes="authoringAction primaryAction" AutomationProperties.Name="Add first sequence step" Margin="0,0,8,8"/>
          <Button Content="Configure instruments" Click="OnConfigureInstruments" Classes="authoringAction" AutomationProperties.Name="Configure instruments from empty plan" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel></Border>
    </ScrollViewer>
    <ListBox x:Name="SequenceList" IsVisible="{Binding HasSequenceContent}" Classes="sequenceCanvas" Background="Transparent" BorderThickness="0" Grid.Row="1" MinHeight="80" ItemsSource="{Binding SequenceItems}" SelectedIndex="{Binding SelectedSequenceIndex}"
        KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Program sequence">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4,4,4,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style Selector="ListBoxItem:selected Border.stepCard"><Setter Property="BorderBrush" Value="{DynamicResource AuthoringAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
        <Style Selector="ListBoxItem:disabled Border.stepCard"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,12,8,4"/></Style>
        <Style Selector="ListBoxItem" x:DataType="vm:SequenceRow">
          <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
          <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
        </Style>
        <Style Selector="ListBoxItem:disabled TextBlock">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SequenceRow">
          <Border Classes="surface stepCard" Padding="18,14" Margin="{Binding Indent, Converter={x:Static vm:LeftIndentConverter.Instance}}"><Grid ColumnDefinitions="Auto,*">
            <Button IsVisible="{Binding IsSection}" Click="OnToggleSection" Width="28" Height="28" Padding="0" Margin="0,0,8,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding SectionToggleLabel}" ToolTip.Tip="{Binding SectionToggleLabel}">
              <Panel><TextBlock Text="▾" IsVisible="{Binding IsExpanded}"/><TextBlock Text="▸" IsVisible="{Binding !IsExpanded}"/></Panel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Opacity="0.7" FontSize="14" TextWrapping="Wrap" Text="{Binding Detail}"/>
          </StackPanel></Grid></Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
