<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.SequenceEditorView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0" AutomationProperties.Name="Sequence editor" ToolTip.Tip="Drag sibling steps or sections to reorder. Right-click for actions, or use Move to section to change grouping.">
    <Button Grid.Row="0" x:Name="SequenceActionsButton" Content="Sections &amp; steps ▾" ToolTip.Tip="Add named device-system sections, organize existing tests, or add steps." HorizontalAlignment="Stretch" Classes="authoringAction" Margin="0,0,0,4">
      <Button.Flyout><Flyout Placement="Bottom">
    <ScrollViewer Width="290" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        AutomationProperties.Name="Sequence actions">
    <StackPanel Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="Device test sections" Classes="sectionTitle" AutomationProperties.HeadingLevel="3"/>
      <TextBlock Text="Group tests by device system. Setup stays first and Cleanup stays last." Classes="purpose" TextWrapping="Wrap"/>
      <TextBlock x:Name="NewSectionLabel" Text="New section name"/>
      <TextBox x:Name="NewSectionNameBox" Text="{Binding NewSectionName}" PlaceholderText="Power supply, communications, display…"
          AutomationProperties.Name="New section name" AutomationProperties.LabeledBy="{Binding #NewSectionLabel}"/>
      <Button Content="Add section" Click="OnAddSection" IsEnabled="{Binding CanEditSequence}"
          AutomationProperties.Name="Add section" Classes="authoringAction sequenceAction"/>
      <Button Content="Expand all sections" Click="OnExpandAllSections" IsEnabled="{Binding CanEditSequence}"
          AutomationProperties.Name="Expand all sections" Classes="authoringAction sequenceAction"/>
      <TextBlock Text="Lifecycle" Classes="sectionTitle"/>
    <WrapPanel Margin="0,0,0,6">
      <Button Content="Setup" Click="OnJumpSection" Tag="Setup" ToolTip.Tip="Jump to Setup and prepare an operator prompt at the end of the section." Classes="authoringAction" AutomationProperties.Name="Manage Setup section"/>
      <Button Content="Measure" Click="OnJumpSection" Tag="Measure" ToolTip.Tip="Jump to Measure and prepare an Acquire recipe at the end of the section." Classes="authoringAction" AutomationProperties.Name="Manage Measure section"/>
      <Button Content="Cleanup" Click="OnJumpSection" Tag="Cleanup" ToolTip.Tip="Jump to Cleanup and prepare Safe Shutdown. Use Add recipe to enable it." Classes="authoringAction" AutomationProperties.Name="Manage Cleanup section"/>
    </WrapPanel>
      <TextBlock x:Name="RecipeLabel" Text="Add to sequence" TextWrapping="Wrap"/>
      <TextBlock x:Name="RecipeSearchLabel" Text="Search Measure, Check, Operator action or Flow" TextWrapping="Wrap"/>
      <TextBox Text="{Binding RecipeSearch}" PlaceholderText="Search sequence palette"
          AutomationProperties.Name="Search sequence palette" AutomationProperties.LabeledBy="{Binding #RecipeSearchLabel}"/>
      <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
          AutomationProperties.Name="Recipe" AutomationProperties.LabeledBy="{Binding #RecipeLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AuthoringRecipe">
            <StackPanel>
              <TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" ToolTip.Tip="{Binding Summary}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="InsertionLabel" Text="Insertion point"/>
      <ComboBox ItemsSource="{Binding InsertionPositions}" SelectedItem="{Binding InsertionPosition}"
          AutomationProperties.Name="Insertion point" AutomationProperties.LabeledBy="{Binding #InsertionLabel}"/>
      <TextBlock Text="{Binding SequenceOperationTarget}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding SelectedRecipePrerequisites}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Button Content="Add recipe" IsEnabled="{Binding CanInsertRecipe}" Click="OnAddRecipe" ToolTip.Tip="{Binding AddRecipeToolTip}"
          AutomationProperties.Name="Add recipe" Classes="authoringAction sequenceAction"/>
      <TextBlock x:Name="RenameLabel" Text="Selected step or section name"/>
      <TextBox Text="{Binding SequenceRename}" AutomationProperties.Name="Selected step name"
          AutomationProperties.LabeledBy="{Binding #RenameLabel}" IsEnabled="{Binding CanRenameSequence}"/>
      <WrapPanel Orientation="Horizontal">
        <Button Classes="authoringAction sequenceAction" Content="Rename" Click="OnRenameSequence" IsEnabled="{Binding CanRenameSequence}" AutomationProperties.Name="Rename selected step"/>
        <Button Classes="authoringAction sequenceAction" Content="Duplicate" Click="OnDuplicateSequence" IsEnabled="{Binding CanDuplicateSequence}" AutomationProperties.Name="Duplicate selected step"/>
        <Button Classes="authoringAction sequenceAction" Content="Move up" Click="OnMoveSequenceUp" IsEnabled="{Binding CanMoveSequence}" AutomationProperties.Name="Move selected step up"/>
        <Button Classes="authoringAction sequenceAction" Content="Move down" Click="OnMoveSequenceDown" IsEnabled="{Binding CanMoveSequence}" AutomationProperties.Name="Move selected step down"/>
      </WrapPanel>
      <TextBlock x:Name="SectionDestinationLabel" Text="Move selected item to section"/>
      <ComboBox x:Name="SectionDestinationBox" ItemsSource="{Binding SectionDestinations}" SelectedItem="{Binding SelectedSectionDestination}"
          AutomationProperties.Name="Destination section" AutomationProperties.LabeledBy="{Binding #SectionDestinationLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AuthoringSectionDestination"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Move to section" Click="OnMoveToSection" IsEnabled="{Binding CanMoveToSection}"
          AutomationProperties.Name="Move selected item to section" Classes="authoringAction sequenceAction"/>
      <TextBlock Text="Moves keep step identities and check dependencies. Loop boundaries remain protected." Classes="purpose" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.9" TextWrapping="Wrap" IsVisible="{Binding HasRawSteps}" Text="{Binding RawStepsBanner}"/>
    </StackPanel>
    </ScrollViewer>
      </Flyout></Button.Flyout>
    </Button>
      <Button Grid.Row="1" Margin="0,0,0,4" Content="{Binding RemoveSequenceActionTitle}" Click="OnRemoveSequence"
          IsEnabled="{Binding CanRemoveSelectedSequence}" ToolTip.Tip="{Binding RemoveSelectedPurpose}"
          AutomationProperties.Name="Remove selected" Classes="authoringAction"/>
    <ListBox x:Name="SequenceList" Classes="authoringList" Grid.Row="2" MinHeight="80" ItemsSource="{Binding SequenceItems}" SelectedIndex="{Binding SelectedSequenceIndex}"
        KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Program sequence">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:SequenceRow">
          <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
          <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
        </Style>
        <Style Selector="ListBoxItem:disabled TextBlock">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SequenceRow">
          <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent, Converter={x:Static vm:LeftIndentConverter.Instance}}">
            <Button IsVisible="{Binding IsSection}" Click="OnToggleSection" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                VerticalAlignment="Top" AutomationProperties.Name="{Binding SectionToggleLabel}" ToolTip.Tip="{Binding SectionToggleLabel}">
              <Panel>
                <TextBlock Text="▾" IsVisible="{Binding IsExpanded}"/>
                <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}"/>
              </Panel>
            </Button>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Text="{Binding Detail}"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
