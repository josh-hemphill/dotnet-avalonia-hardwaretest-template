<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.SequenceEditorView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <DockPanel Margin="0,0,12,0" AutomationProperties.Name="Sequence editor" ToolTip.Tip="{Binding MeasureHint}">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock x:Name="RecipeLabel" Text="Add to sequence" TextWrapping="Wrap"/>
      <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
          AutomationProperties.Name="Recipe" AutomationProperties.LabeledBy="{Binding #RecipeLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AuthoringRecipe">
            <StackPanel>
              <TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" ToolTip.Tip="{Binding Summary}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Add recipe" Click="OnAddRecipe" ToolTip.Tip="{Binding AddRecipeToolTip}"
          AutomationProperties.Name="Add recipe" Classes="authoringAction"/>
      <TextBlock Opacity="0.9" TextWrapping="Wrap" IsVisible="{Binding HasRawSteps}" Text="{Binding RawStepsBanner}"/>
      <Button Content="{Binding RemoveSelectedTitle}" Click="OnRemoveSequence"
          IsEnabled="{Binding CanRemoveSelectedSequence}" ToolTip.Tip="{Binding RemoveSelectedPurpose}"
          AutomationProperties.Name="Remove selected" Classes="authoringAction"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding SequenceItems}" SelectedIndex="{Binding SelectedSequenceIndex}"
        KeyboardNavigation.TabNavigation="Once" KeyDown="OnSequenceKeyDown" AutomationProperties.Name="Program sequence">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:SequenceRow">
          <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
          <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
        </Style>
        <Style Selector="ListBoxItem:disabled TextBlock">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SequenceRow">
          <StackPanel Margin="{Binding Indent, Converter={x:Static vm:LeftIndentConverter.Instance}}">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
            <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Text="{Binding Detail}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
