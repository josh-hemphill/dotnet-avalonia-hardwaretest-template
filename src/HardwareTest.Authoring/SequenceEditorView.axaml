<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.SequenceEditorView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" AutomationProperties.Name="Sequence editor">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="RUN ORDER" Classes="eyebrow"/><TextBlock Text="Select a step to configure it" Classes="purpose" TextWrapping="Wrap"/></StackPanel>
      <Button Grid.Column="1" x:Name="SequenceActionsButton" Content="+ Add step" Click="OnOpenPalette" Classes="authoringAction primaryAction" AutomationProperties.Name="Add step" IsEnabled="{Binding CanEditProgramSettings}"/>
    </Grid>
    <ListBox x:Name="SequenceList" Classes="sequenceCanvas" Background="Transparent" BorderThickness="0" Grid.Row="1" MinHeight="80" ItemsSource="{Binding SequenceItems}" SelectedIndex="{Binding SelectedSequenceIndex}"
        KeyboardNavigation.TabNavigation="Once" KeyDown="OnSequenceKeyDown" AutomationProperties.Name="Program sequence">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4,4,4,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style Selector="ListBoxItem:selected Border.stepCard"><Setter Property="BorderBrush" Value="{DynamicResource AuthoringAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
        <Style Selector="ListBoxItem:disabled Border.stepCard"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,12,8,4"/></Style>
        <Style Selector="ListBoxItem" x:DataType="vm:SequenceRow">
          <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
          <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
        </Style>
        <Style Selector="ListBoxItem:disabled TextBlock">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SequenceRow">
          <Border Classes="surface stepCard" Padding="18,14" Margin="{Binding Indent, Converter={x:Static vm:LeftIndentConverter.Instance}}"><StackPanel Spacing="6">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Opacity="0.7" FontSize="14" TextWrapping="Wrap" Text="{Binding Detail}"/>
          </StackPanel></Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
