<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HardwareTest.Authoring" x:Class="HardwareTest.Authoring.HardwareView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <StackPanel Spacing="8">
    <WrapPanel>
      <Button Content="Add instrument…" Click="OnShowAddInstrument" Classes="authoringAction primaryAction" Margin="0,0,8,4" AutomationProperties.Name="Open add instrument"/>
      <Button Content="Reusable templates…" Click="OnOpenDefinitions" Classes="authoringAction" Margin="0,0,8,4" AutomationProperties.Name="Manage reusable hardware templates"/>
      <Button Content="Environment" Click="OnOpenEnvironment" Classes="authoringAction" Margin="0,0,8,4" AutomationProperties.Name="Open hardware environment" ToolTip.Tip="Prepare instrument packages and inspect execution prerequisites"/>
    </WrapPanel>
    <TextBlock Text="No slots yet. Add an instrument, or continue with operator steps and calculations until its address is known." TextWrapping="Wrap" IsVisible="{Binding !Instruments.Count}"/>
    <Border Classes="surface" Padding="10">
      <vm:HardwareBindingGrid>
        <StackPanel Spacing="8">
          <TextBlock Text="Applied to this plan" FontWeight="SemiBold" AutomationProperties.HeadingLevel="3"/>
          <ListBox x:Name="InstrumentSlotsList" ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Instruments" Classes="authoringList" MaxHeight="160" MinHeight="64">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstrumentRef">
                <TextBlock Text="{Binding SlotName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VisaAddress}" AutomationProperties.Name="{Binding SlotName, StringFormat='Instrument slot {0}'}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding SelectedInstrumentSlot, StringFormat='Selected slot: {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Instrument slot"/>
          <TextBlock x:Name="VisaLabel" Text="Applied address"/>
          <TextBox Text="{Binding SelectedInstrumentVisa, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" AutomationProperties.Name="VISA address" AutomationProperties.LabeledBy="{Binding #VisaLabel}" ToolTip.Tip="Load this binding into the editor, then review the change"/>
          <Button x:Name="LoadBindingButton" Content="Edit selected binding" IsEnabled="{Binding Instruments.Count}" Click="OnLoadBinding" AutomationProperties.Name="Load selected binding" Classes="authoringAction" HorizontalAlignment="Stretch"/>
          <ItemsControl ItemsSource="{Binding SelectedHardwareRows}" AutomationProperties.Name="Hardware binding table">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AuthoringHardwareRow">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding PackageSummary}" TextWrapping="Wrap"/>
                  <Expander Header="Package details" IsVisible="{Binding HasPackageDetails}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Selected binding package details">
                    <TextBlock Text="{Binding PackageStatus}" TextWrapping="Wrap"/>
                  </Expander>
                  <Expander Header="Type, usage and cleanup" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding TypeId}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Usage}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Cleanup}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding HardwareEditorContext}" AutomationProperties.Name="Loaded binding context" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="BindingDraftState" IsVisible="{Binding CanReviewLoadedHardwareBinding}" Text="Load a binding to edit its type and address." TextWrapping="Wrap" AutomationProperties.Name="Binding draft state" AutomationProperties.LiveSetting="Polite"/>
          <Grid IsEnabled="{Binding CanReviewLoadedHardwareBinding}" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
            <TextBlock x:Name="BindingTypeLabel" Text="Adapter" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ComboBox x:Name="BindingTypeBox" Grid.Column="1" ItemsSource="{Binding InstrumentTypeChoices}" SelectedItem="{Binding HardwareEditType, Mode=OneWay}" SelectionChanged="OnHardwareEditTypeChanged" AutomationProperties.Name="Hardware adapter type" AutomationProperties.LabeledBy="{Binding #BindingTypeLabel}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AuthoringInstrumentAdapter"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="BindingAddressLabel" Grid.Row="1" Text="Address" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBox x:Name="BindingAddressBox" Grid.Row="1" Grid.Column="1" Text="{Binding HardwareEditAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hardware adapter address" AutomationProperties.LabeledBy="{Binding #BindingAddressLabel}"/>
            <TextBlock x:Name="BindingTimeoutLabel" Grid.Row="2" Text="Timeout (ms)" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding HardwareEditType, Converter={x:Static vm:InstrumentTimeoutLabelConverter.Instance}}"/>
            <TextBox x:Name="BindingTimeoutBox" Grid.Row="2" Grid.Column="1" Text="{Binding HardwareEditTimeout, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HardwareEditType, Converter={x:Static vm:InstrumentTimeoutSupportConverter.Instance}}" PlaceholderText="Adapter default" AutomationProperties.Name="Hardware adapter timeout" AutomationProperties.LabeledBy="{Binding #BindingTimeoutLabel}" AutomationProperties.HelpText="{Binding HardwareEditType, Converter={x:Static vm:InstrumentTimeoutLabelConverter.Instance}}" ToolTip.Tip="{Binding HardwareEditType, Converter={x:Static vm:InstrumentTimeoutLabelConverter.Instance}}"/>
          </Grid>
          <WrapPanel>
            <Button x:Name="ReviewBindingButton" Content="Review binding change" Click="OnReviewBinding" IsEnabled="{Binding CanReviewLoadedHardwareBinding}" AutomationProperties.Name="Review binding change" Classes="authoringAction primaryAction" Margin="0,0,8,4"/>
            <Button Content="Reload applied values" Click="OnReloadBinding" IsEnabled="{Binding CanReviewLoadedHardwareBinding}" AutomationProperties.Name="Reload applied binding values" Classes="authoringAction" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock Text="{Binding HardwareEditTypeGuidance}" TextWrapping="Wrap" Classes="purpose" AutomationProperties.Name="Selected adapter guidance"/>
          <Button Content="Resolve types and packages in Environment" Click="OnOpenEnvironment" Classes="authoringAction" HorizontalAlignment="Left"/>
          <Expander Header="Remove selected slot" AutomationProperties.Name="Remove instrument section" HorizontalContentAlignment="Stretch" Classes="inspectorSection">
            <StackPanel Spacing="12">
              <TextBlock Text="Removal affects only this plan and remains subject to binding-use guards." Classes="purpose" TextWrapping="Wrap"/>
              <Button Classes="authoringAction" Content="Remove slot from selected program" Click="OnRemoveInstrumentSlot" IsEnabled="{Binding CanRemoveSelectedInstrumentSlot}" ToolTip.Tip="{Binding InstrumentRemovalGuardText}" AutomationProperties.HelpText="{Binding InstrumentRemovalGuardText}" AutomationProperties.Name="Remove instrument slot from selected program"/>
              <TextBlock Text="{Binding InstrumentRemovalGuardText}" TextWrapping="Wrap" AutomationProperties.Name="Instrument removal guidance"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </vm:HardwareBindingGrid>
    </Border>
    <Expander Header="Add an instrument slot" HorizontalContentAlignment="Stretch" Classes="inspectorSection" x:Name="AddInstrumentSection" AutomationProperties.Name="Add instrument section">
      <StackPanel Spacing="12">
        <TextBlock Text="Add a program slot" Classes="sectionTitle" TextWrapping="Wrap" AutomationProperties.HeadingLevel="3"/>
        <TextBlock Text="Name the slot, choose an instrument type, then enter its real resource address." Classes="purpose" TextWrapping="Wrap"/>
        <Expander Header="Address not known yet?" AutomationProperties.Name="Deferred instrument address guidance">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Keep authoring without adding this slot. Save all preserves your draft; add the slot here when the address is known." TextWrapping="Wrap"/>
            <TextBlock Text="In New test plan, choose to save without hardware. Add instrument-dependent steps after binding the slot. Mock DMM is for demo plans, not a placeholder for physical hardware." TextWrapping="Wrap" Classes="purpose"/>
            <Button Content="Continue authoring; bind later" Click="OnDeferBinding" Classes="authoringAction" AutomationProperties.Name="Defer instrument binding"/>
            <TextBlock Text="Existing physical bindings need a valid address. This form does not create unresolved hardware slots." TextWrapping="Wrap" Classes="purpose"/>
          </StackPanel>
        </Expander>
        <TextBlock x:Name="NewSlotLabel" Text="Add instrument slot"/>
        <TextBox Text="{Binding NewInstrumentSlot}" PlaceholderText="SCOPE" AutomationProperties.Name="Add instrument slot" AutomationProperties.LabeledBy="{Binding #NewSlotLabel}"/>
        <TextBlock x:Name="NewInstrumentTypeLabel" Text="New instrument type"/>
        <ComboBox ItemsSource="{Binding InstrumentTypeChoices}" SelectedItem="{Binding SelectedNewInstrumentType}" AutomationProperties.Name="New instrument type" AutomationProperties.LabeledBy="{Binding #NewInstrumentTypeLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AuthoringInstrumentAdapter">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding NewInstrumentTypeGuidance}" TextWrapping="Wrap" Classes="purpose" AutomationProperties.Name="New instrument type guidance"/>
        <Button Content="Find missing instrument types in Environment" Click="OnOpenEnvironment" Classes="authoringAction"/>
        <TextBlock Text="{Binding NewInstrumentAvailabilityText}" TextWrapping="Wrap" AutomationProperties.Name="New instrument availability"/>
        <TextBlock x:Name="NewVisaLabel" Text="New slot resource address"/>
        <TextBox Text="{Binding NewInstrumentVisa}" PlaceholderText="Resource address for the selected instrument" AutomationProperties.Name="New slot VISA" AutomationProperties.LabeledBy="{Binding #NewVisaLabel}"/>
        <Button Classes="authoringAction primaryAction" Content="Add instrument slot" Click="OnAddInstrumentSlot" IsEnabled="{Binding CanAddInstrumentSlot}" ToolTip.Tip="Appends a slot to this program and stages a workspace slot suggestion. Use Save All for catalog changes." AutomationProperties.Name="Add instrument slot"/>
      </StackPanel>
    </Expander>
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding InstrumentCatalogSummary}" TextWrapping="Wrap" AutomationProperties.Name="Supported instrument types summary"/>
      <Expander Header="Browse available types" HorizontalContentAlignment="Stretch" Classes="inspectorSection">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding InstrumentTypeChoices}" AutomationProperties.Name="Supported instrument types">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AuthoringInstrumentAdapter">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TypeId}" Classes="purpose" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding RequiredPackage}" Classes="purpose" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
