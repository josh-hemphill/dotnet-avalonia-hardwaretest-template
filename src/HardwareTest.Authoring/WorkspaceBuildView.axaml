<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HardwareTest.Authoring" xmlns:host="using:HardwareTest.OpenTap.Host"
    x:Class="HardwareTest.Authoring.WorkspaceBuildView" x:DataType="vm:AuthoringWorkspaceViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="0,8,16,0">
      <TextBlock TextWrapping="Wrap" Text="{Binding ShipPurpose}"/>
      <TextBlock FontWeight="SemiBold"
          Text="{Binding PackPreview.ProgramPackageName, StringFormat='Program package {0}'}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding PackPreview.ProgramPackageVersion, StringFormat='Version {0}'}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding OpenTapPinText}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding AuthoringHomeText}" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap"
          Text="TUI is not part of a production pack. Shell apps stay bake-time and are not launched from this app."/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding HasInstrumentComponentsPackage}"
          Text="{Binding InstrumentComponentsText}"/>
      <TextBlock FontWeight="SemiBold" Text="TapPackage files" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding PackPreview.ProgramPackContents}"
          AutomationProperties.Name="Program pack files">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackFileLine">
            <TextBlock Text="{Binding RelativePath, StringFormat='{}{0}'}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" Text="Package dependencies" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasPackageDependencies}"
          Text="No package dependencies declared in authoring.json."/>
      <ItemsControl ItemsSource="{Binding PackPreview.PackageDependencies}"
          AutomationProperties.Name="Package dependencies">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackDependencyLine">
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" Text="Authoring OpenTAP home packages" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasAuthoringHomePackages}"
          Text="Bootstrap to install Editor packs into the isolated OpenTAP home."/>
      <ItemsControl ItemsSource="{Binding PackPreview.AuthoringHomePackages}"
          AutomationProperties.Name="Authoring OpenTAP home packages">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OpenTapEnvironmentLine">
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" Text="Extra plugins" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasDeclaredPlugins}"
          Text="No extra plugin TapPackages declared."/>
      <ItemsControl ItemsSource="{Binding PackPreview.PluginProjects}" AutomationProperties.Name="Ship plugin projects">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackDeclaredProjectLine">
            <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" Text="Shell apps (bake-time)" TextWrapping="Wrap"/>
      <TextBlock Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding !HasDeclaredShellApps}"
          Text="No bake-time shell apps declared."/>
      <ItemsControl ItemsSource="{Binding PackPreview.ShellAppProjects}"
          AutomationProperties.Name="Ship shell-app projects">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackDeclaredProjectLine">
            <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" IsVisible="{Binding HasLastPack}" Text="Last pack" TextWrapping="Wrap"/>
      <TextBlock IsVisible="{Binding HasLastPack}" TextWrapping="Wrap" Text="{Binding PackPreview.LastOutputDirectory}"/>
      <ItemsControl ItemsSource="{Binding LastShippedFiles}" IsVisible="{Binding HasLastPack}"
          AutomationProperties.Name="Last shipped files">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontWeight="SemiBold" IsVisible="{Binding HasLastShippedBakeTimeFiles}"
          Text="Bake-time files in last pack" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding LastShippedBakeTimeFiles}" IsVisible="{Binding HasLastShippedBakeTimeFiles}"
          AutomationProperties.Name="Last shipped bake-time files">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding PackGuardText}" TextWrapping="Wrap" AutomationProperties.Name="Pack save guard"/>
      <TextBlock Text="{Binding PackPreflightHomeText}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding PackPreflightFindings}" AutomationProperties.Name="Pack preflight findings">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackPreflightFinding">
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock IsVisible="{Binding HasExcludedPackPlans}" Text="Opened plans excluded from this TapPackage"
          FontWeight="SemiBold" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding ExcludedPackPlans}" AutomationProperties.Name="Excluded pack plans"/>
      <TextBlock Text="Exploration formulas excluded from deployment artifacts" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding ExcludedExplorationFormulas}" AutomationProperties.Name="Excluded exploration formulas"/>
      <Button Content="Pack…" IsEnabled="{Binding CanPack}" Click="OnPack"
          ToolTip.Tip="Validate, then write package.xml, the program TapPackage, declared plugin copies, bake-time shell apps, and ship-manifest.json"
          AutomationProperties.Name="Pack workspace" Classes="authoringAction"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
