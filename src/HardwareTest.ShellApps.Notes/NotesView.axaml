<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.ShellApps.Notes"
             x:Class="HardwareTest.ShellApps.Notes.NotesView"
             x:DataType="vm:NotesViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="16" MaxWidth="720">
      <TextBlock Text="{Binding Title}"
                 FontSize="28"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}"
                 TextWrapping="Wrap"
                 Opacity="0.85"
                 FontSize="16" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
