<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HardwareTest"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:shell="using:HardwareTest.Features.Shell"
             x:Class="HardwareTest.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <sty:FluentAvaloniaTheme />
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#C62828" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#B71C1C" />
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E53935" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#B71C1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.success">
      <Setter Property="Background" Value="#2E7D32" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#1B5E20" />
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#43A047" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B5E20" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1565C0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0D47A1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E88E5" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0D47A1" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#90CAF9" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <!-- Phase 18: default operator Button floor (override with denser classes only when intentional). -->
    <Style Selector="Button.operator">
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.startup-overlay">
      <Style.Animations>
        <Animation Duration="0:0:0.25" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.filter-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.filter-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
    </Style>
    <Style Selector="Button.filter-chip:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="ToggleButton.filter-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToggleButton.filter-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
    </Style>
    <Style Selector="ToggleButton.filter-chip:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.operator-list ListBoxItem">
      <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <!-- Phase 21: Run operational text floor (chips, step rows, compact captions). -->
    <Style Selector="TextBlock.op-type">
      <Setter Property="FontSize" Value="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
    </Style>
    <Style Selector="TextBlock.settings-h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBox.error">
      <Setter Property="BorderBrush" Value="#C62828" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Border.feedback-banner">
      <Style.Animations>
        <Animation Duration="0:0:0.18" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.session-block">
      <Style.Animations>
        <Animation Duration="0:0:0.2" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>
</Application>
