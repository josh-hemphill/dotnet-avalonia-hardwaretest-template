<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:HardwareTest.Features"
        x:Class="HardwareTest.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hardware Test"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600">
  <ui:FANavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="False"
                       OpenPaneLength="220"
                       IsPaneOpen="{Binding IsNavPaneOpen, Mode=TwoWay}"
                       MenuItemsSource="{Binding NavigationItems}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
    <ui:FANavigationView.MenuItemTemplate>
      <DataTemplate x:DataType="vm:NavItem">
        <ui:FANavigationViewItem Content="{Binding Title}" Tag="{Binding Id}">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="{Binding Symbol}" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </DataTemplate>
    </ui:FANavigationView.MenuItemTemplate>

    <ui:FANavigationView.PaneFooter>
      <StackPanel Margin="8,12" Spacing="6">
        <TextBlock Text="{Binding ControlStatus}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.85"
                   IsVisible="{Binding IsNavPaneOpen}" />
        <Button Command="{Binding PauseResumeCommand}"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsRunning}"
                Classes.success="{Binding ShowContinueIcon}"
                ToolTip.Tip="{Binding PauseResumeTip}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <ui:FASymbolIcon Symbol="Pause" FontSize="16" IsVisible="{Binding ShowPauseIcon}" />
            <ui:FASymbolIcon Symbol="Play" FontSize="16" IsVisible="{Binding ShowResumeIcon}" />
            <ui:FASymbolIcon Symbol="Accept" FontSize="16" IsVisible="{Binding ShowContinueIcon}" />
            <TextBlock Text="{Binding PauseResumeLabel}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsNavPaneOpen}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding SafetyStopCommand}"
                HorizontalAlignment="Stretch"
                Classes="danger"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="{Binding SafetyStopTip}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <ui:FASymbolIcon Symbol="Stop" FontSize="16" />
            <TextBlock Text="{Binding SafetyStopLabel}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsNavPaneOpen}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ui:FANavigationView.PaneFooter>

    <Panel Margin="16">
      <ContentControl Content="{Binding CurrentPage}" />
    </Panel>
  </ui:FANavigationView>
</Window>
