<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:HardwareTest.Features"
        x:Class="HardwareTest.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hardware Test"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600">
  <ui:FANavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="False"
                       OpenPaneLength="220"
                       IsPaneOpen="{Binding IsNavPaneOpen, Mode=TwoWay}"
                       MenuItemsSource="{Binding NavigationItems}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
    <ui:FANavigationView.MenuItemTemplate>
      <DataTemplate x:DataType="vm:NavItem">
        <ui:FANavigationViewItem Content="{Binding Title}" Tag="{Binding Id}">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="{Binding Symbol}" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </DataTemplate>
    </ui:FANavigationView.MenuItemTemplate>

    <ui:FANavigationView.PaneFooter>
      <!-- Compact: fixed-width centered icon buttons. Expanded: stretch with icon+label. -->
      <StackPanel Margin="0,12" Spacing="6" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding ControlStatus}"
                   FontSize="12"
                   Margin="12,0"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.85"
                   IsVisible="{Binding IsNavPaneOpen}" />

        <!-- Pause / Resume / Continue -->
        <Button Command="{Binding PauseResumeCommand}"
                Width="40"
                Height="36"
                Padding="0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                IsEnabled="{Binding IsRunning}"
                Classes.success="{Binding ShowContinueIcon}"
                ToolTip.Tip="{Binding PauseResumeTip}"
                IsVisible="{Binding !IsNavPaneOpen}">
          <ui:FASymbolIcon Symbol="{Binding PauseResumeSymbol}"
                           FontSize="16"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Button>
        <Button Command="{Binding PauseResumeCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,6"
                MinHeight="36"
                IsEnabled="{Binding IsRunning}"
                Classes.success="{Binding ShowContinueIcon}"
                ToolTip.Tip="{Binding PauseResumeTip}"
                IsVisible="{Binding IsNavPaneOpen}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ui:FASymbolIcon Symbol="{Binding PauseResumeSymbol}"
                             FontSize="16"
                             Width="16"
                             Height="16"
                             VerticalAlignment="Center" />
            <TextBlock Text="{Binding PauseResumeLabel}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Safety Stop -->
        <Button Command="{Binding SafetyStopCommand}"
                Width="40"
                Height="36"
                Padding="0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="danger"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="{Binding SafetyStopTip}"
                IsVisible="{Binding !IsNavPaneOpen}">
          <ui:FASymbolIcon Symbol="StopFilled"
                           FontSize="16"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Button>
        <Button Command="{Binding SafetyStopCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,6"
                MinHeight="36"
                Classes="danger"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="{Binding SafetyStopTip}"
                IsVisible="{Binding IsNavPaneOpen}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ui:FASymbolIcon Symbol="StopFilled"
                             FontSize="16"
                             Width="16"
                             Height="16"
                             VerticalAlignment="Center" />
            <TextBlock Text="{Binding SafetyStopLabel}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ui:FANavigationView.PaneFooter>

    <Panel Margin="16">
      <ContentControl Content="{Binding CurrentPage}"
                      IsEnabled="{Binding !IsStartingUp}" />
      <Border IsVisible="{Binding IsStartingUp}"
              Classes="startup-overlay"
              Background="#CC1A1A1A"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="14"
                    Margin="24">
          <TextBlock Text="Hardware Test"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="White"
                     HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True"
                       Width="280"
                       Height="4" />
          <TextBlock Text="{Binding StartupStatus}"
                     Foreground="White"
                     Opacity="0.9"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="360"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
  </ui:FANavigationView>
</Window>
