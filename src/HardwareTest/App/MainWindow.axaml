<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:HardwareTest.Features"
        xmlns:shell="using:HardwareTest.Features.Shell"
        x:Class="HardwareTest.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hardware Test"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600">
  <ui:FANavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="False"
                       OpenPaneLength="220"
                       CompactPaneLength="48"
                       IsPaneOpen="{Binding IsNavPaneOpen, Mode=TwoWay}"
                       MenuItemsSource="{Binding NavigationItems}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
    <ui:FANavigationView.MenuItemTemplate>
      <DataTemplate x:DataType="vm:NavItem">
        <ui:FANavigationViewItem Content="{Binding Title}" Tag="{Binding Id}">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="{Binding Symbol}" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </DataTemplate>
    </ui:FANavigationView.MenuItemTemplate>

    <ui:FANavigationView.PaneFooter>
      <!-- Compact buttons are full CompactPaneLength wide so glyphs share the same center as menu icons. -->
      <StackPanel Margin="0,8,0,12" Spacing="6" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding ControlStatus}"
                   FontSize="12"
                   Margin="12,0"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.85"
                   IsVisible="{Binding IsNavPaneOpen}" />

        <!-- Pause / Resume / Continue -->
        <Button Command="{Binding PauseResumeCommand}"
                Width="{x:Static shell:OperatorTouchDensity.CompactNavTargetSize}"
                Height="{x:Static shell:OperatorTouchDensity.CompactNavTargetSize}"
                Padding="0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                IsEnabled="{Binding IsRunning}"
                Classes.success="{Binding ShowContinueIcon}"
                ToolTip.Tip="{Binding PauseResumeTip}"
                AutomationProperties.Name="{Binding PauseResumeLabel}"
                IsVisible="{Binding !IsNavPaneOpen}">
          <ui:FASymbolIcon Symbol="{Binding PauseResumeSymbol}"
                           FontSize="16"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Button>
        <Button Command="{Binding PauseResumeCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,8"
                MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                IsEnabled="{Binding IsRunning}"
                Classes.success="{Binding ShowContinueIcon}"
                ToolTip.Tip="{Binding PauseResumeTip}"
                AutomationProperties.Name="{Binding PauseResumeLabel}"
                IsVisible="{Binding IsNavPaneOpen}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ui:FASymbolIcon Symbol="{Binding PauseResumeSymbol}"
                             FontSize="16"
                             Width="16"
                             Height="16"
                             VerticalAlignment="Center" />
            <TextBlock Text="{Binding PauseResumeLabel}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Safety Stop -->
        <Button Command="{Binding SafetyStopCommand}"
                Width="{x:Static shell:OperatorTouchDensity.CompactNavTargetSize}"
                Height="{x:Static shell:OperatorTouchDensity.CompactNavTargetSize}"
                Padding="0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="danger"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="{Binding SafetyStopTip}"
                AutomationProperties.Name="{Binding SafetyStopLabel}"
                IsVisible="{Binding !IsNavPaneOpen}">
          <ui:FASymbolIcon Symbol="StopFilled"
                           FontSize="16"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Button>
        <Button Command="{Binding SafetyStopCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,8"
                MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                Classes="danger"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="{Binding SafetyStopTip}"
                AutomationProperties.Name="{Binding SafetyStopLabel}"
                IsVisible="{Binding IsNavPaneOpen}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ui:FASymbolIcon Symbol="StopFilled"
                             FontSize="16"
                             Width="16"
                             Height="16"
                             VerticalAlignment="Center" />
            <TextBlock Text="{Binding SafetyStopLabel}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ui:FANavigationView.PaneFooter>

    <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="8">
      <!-- Phase 17: reserved height even when idle — notifications must not shift page content. -->
      <Border MinHeight="56"
              Padding="10,8"
              CornerRadius="6"
              BorderThickness="1"
              Classes="feedback-banner">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
          </Style>
        </Border.Styles>
        <Panel>
          <Border IsVisible="{Binding ShellNotification.HasContent}"
                  Background="{Binding ShellNotification.Severity, Converter={x:Static shell:ShellNotificationBrushConverter.Background}}"
                  BorderBrush="{Binding ShellNotification.Severity, Converter={x:Static shell:ShellNotificationBrushConverter.Border}}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Margin="-10,-8"
                  Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding ShellNotification.Severity, Converter={x:Static shell:ShellNotificationBrushConverter.Icon}}"
                         FontSize="14"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ShellNotification.Message}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold" />
              <Button Grid.Column="2"
                      Content="{Binding ShellNotification.PrimaryLabel}"
                      Command="{Binding ShellNotification.PrimaryCommand}"
                      IsVisible="{Binding ShellNotification.HasPrimaryAction}"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Padding="10,4" />
              <Button Grid.Column="3"
                      Content="{Binding ShellNotification.SecondaryLabel}"
                      Command="{Binding ShellNotification.SecondaryCommand}"
                      IsVisible="{Binding ShellNotification.HasSecondaryAction}"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Padding="10,4" />
              <Button Grid.Column="4"
                      Content="Dismiss"
                      Command="{Binding ShellNotification.DismissCommand}"
                      IsVisible="{Binding ShellNotification.IsDismissible}"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Padding="10,4" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding ShellNotification.IdleHint}"
                     Opacity="0.55"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !ShellNotification.HasContent}" />
        </Panel>
      </Border>

      <Panel Grid.Row="1">
        <ContentControl Content="{Binding CurrentPage}"
                        IsEnabled="{Binding !IsStartingUp}" />
        <Border IsVisible="{Binding IsStartingUp}"
                Classes="startup-overlay"
                Background="#CC1A1A1A"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="14"
                      Margin="24">
            <TextBlock Text="Hardware Test"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True"
                         Width="280"
                         Height="4" />
            <TextBlock Text="{Binding StartupStatus}"
                       Foreground="White"
                       Opacity="0.9"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </ui:FANavigationView>
</Window>
