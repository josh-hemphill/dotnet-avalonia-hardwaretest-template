<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Results"
             xmlns:runVm="using:HardwareTest.Features.RunTest"
             xmlns:runs="using:HardwareTest.Core.Runs"
             xmlns:pres="using:HardwareTest.Features.Presentation"
             xmlns:storage="using:HardwareTest.Core.Storage"
             xmlns:widgetsPres="using:HardwareTest.Widgets.Presentation"
             xmlns:conv="using:HardwareTest.Converters"
             xmlns:shell="using:HardwareTest.Features.Shell"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="HardwareTest.Features.Results.ResultsView"
             x:Name="Root"
             x:DataType="vm:ResultsViewModel">
  <Grid>
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,360" ColumnSpacing="12" RowSpacing="12">
    <WrapPanel Orientation="Horizontal" Grid.ColumnSpan="2">
      <Button Content="Refresh" Command="{Binding RefreshCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Command="{Binding OpenDefaultReportCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              AutomationProperties.Name="Open report"
              ToolTip.Tip="Open the default PDF for the selected run (double-click the row also works)">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:FASymbolIcon Symbol="{x:Static ui:FASymbol.DocumentFilled}" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="Open report" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ReprintCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              AutomationProperties.Name="Regenerate reports"
              IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="{x:Static vm:ResultsViewModel.RegenerateReportsTip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:FASymbolIcon Symbol="{x:Static ui:FASymbol.Document}" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="Regenerate reports" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Text="Working…"
                 IsVisible="{Binding IsBusy}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Opacity="0.8"
                 Margin="0,0,8,4" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,8,4" />
    </WrapPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" ClipToBounds="True">
      <StackPanel Spacing="6" Margin="0,0,0,8">
        <TextBox PlaceholderText="Search plan, DUT, operator, run id…"
                 Text="{Binding SearchText}" />
        <WrapPanel>
          <ComboBox ItemsSource="{Binding ResultFilterOptions}"
                    SelectedItem="{Binding ResultFilter}"
                    MinWidth="100"
                    Margin="0,0,8,4" />
          <ComboBox ItemsSource="{Binding PlanFilterOptions}"
                    SelectedItem="{Binding PlanFilter}"
                    MinWidth="120"
                    Margin="0,0,8,4" />
          <ComboBox ItemsSource="{Binding DutFilterOptions}"
                    SelectedItem="{Binding DutFilter}"
                    MinWidth="120"
                    Margin="0,0,8,4" />
          <ComboBox ItemsSource="{Binding OperatorFilterOptions}"
                    SelectedItem="{Binding OperatorFilter}"
                    MinWidth="120"
                    Margin="0,0,8,4" />
          <ComboBox ItemsSource="{Binding DateFilterOptions}"
                    SelectedItem="{Binding DateFilter}"
                    MinWidth="120"
                    Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock Text="{Binding FilterStatus}" Opacity="0.7" FontSize="11" />
        <TextBlock Text="{Binding SchemaDriftSummary}"
                   IsVisible="{Binding HasSchemaDrift}"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   FontSize="11" />

      </StackPanel>

      <!-- Empty state: no runs yet -->
      <Border Grid.Row="1"
              Padding="12,10"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              IsVisible="{Binding !HasRuns}"
              Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="No runs yet — confirm a DUT and run a program on the Run page to see results here."
                     VerticalAlignment="Center"
                     Opacity="0.85"
                     TextWrapping="Wrap" />
          <Button Content="Go to Run"
                  Command="{Binding NavigateToRunCommand}"
                  Classes="operator"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <ListBox Grid.Row="2" ClipToBounds="True" Focusable="True" AutomationProperties.Name="Recorded runs" ItemsSource="{Binding Runs}"
               Classes="operator-list"
               SelectedItem="{Binding SelectedRun}"
               DoubleTapped="OnRunsDoubleTapped"
               MinHeight="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="runs:TestRunSummary">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PlanName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Read-only" IsVisible="{Binding IsSchemaReadOnly}" Opacity="0.7"/>
                <TextBlock Text="{Binding DutSerial, StringFormat='DUT: {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DutPartNumber, StringFormat='Part: {0}'}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OperatorName, StringFormat='Operator: {0}'}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SessionId, Converter={x:Static conv:ShortIdConverter.Instance}, StringFormat='Session: {0}'}" FontSize="11"/>
                <TextBlock Text="{Binding StartedAt}" Opacity="0.75" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                      Background="{Binding Result, Converter={x:Static runVm:ChipBrushConverter.Instance}}">
                <TextBlock Text="{Binding Result}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Border Grid.Row="1" Grid.Column="1"
            IsVisible="{Binding ShowDetail}"
            Padding="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <!-- Sticky chrome: keep Close/schema out of the scroller so the bar cannot cover them. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding OpenedRun.RunId, Converter={x:Static conv:ShortIdConverter.Instance}, StringFormat=Run {0}}"
                       FontWeight="SemiBold"
                       ToolTip.Tip="{Binding OpenedRun.RunId}" />
            <Border Grid.Column="1"
                    IsVisible="{Binding HasSchemaBadge}"
                    Padding="6,2"
                    CornerRadius="3"
                    Background="{DynamicResource SystemControlBackgroundBaseMediumBrush}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SchemaBadge}" FontSize="11" Opacity="0.9" />
            </Border>
            <Button Grid.Column="2" Content="Close" Command="{Binding CloseDetailCommand}" />
          </Grid>
          <TextBlock Text="{Binding SchemaWarning}"
                     IsVisible="{Binding HasSchemaWarning}"
                     TextWrapping="Wrap"
                     Opacity="0.85"
                     FontSize="11" />
          <TextBlock Text="{Binding OpenedRun.DutSerial, StringFormat=DUT: {0}}" Opacity="0.85" />
          <TextBlock Text="{Binding OpenedRun.DutPartNumber, StringFormat=Part: {0}}" Opacity="0.75" />
          <TextBlock Text="{Binding OpenedRun.OperatorName, StringFormat=Operator: {0}}" Opacity="0.75" />
          <StackPanel Spacing="2" IsVisible="{Binding HasAttestation}">
            <TextBlock Text="Certification" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AttestationSummary}" TextWrapping="Wrap" Opacity="0.9" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Padding="0,0,4,0">
          <StackPanel Spacing="6">
            <Border IsVisible="{Binding OpenedRun.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4">
              <StackPanel Spacing="6">
                <TextBlock Text="Run outcome and recovery" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OpenedRun.ErrorMessage}" TextWrapping="Wrap" AutomationProperties.Name="Run outcome details"/>
              </StackPanel>
            </Border>
            <StackPanel Spacing="2" IsVisible="{Binding HasReports}">
              <TextBlock Text="Reports" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding ReportItems}" SelectedItem="{Binding SelectedReportItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RunReportItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="8">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding RoleLabel}"
                                     Opacity="0.65"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="(default)"
                                     Opacity="0.65"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsDefault}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VerificationText}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Open"
                              Command="{Binding #Root.((vm:ResultsViewModel)DataContext).OpenReportCommand}"
                              CommandParameter="{Binding}"
                              FontSize="11"
                              Margin="0,0,8,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasExportTargets}">
              <TextBlock Text="Export package" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static vm:ResultsViewModel.ExportPackageHelp}"
                         Opacity="0.75" FontSize="11" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding ExportTargets}"
                        SelectedItem="{Binding SelectedExportTarget}"
                        MinWidth="280"
                        MaxWidth="340">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="storage:ExportTarget">
                    <TextBlock Text="{Binding DisplayName}"
                               TextWrapping="Wrap"
                               ToolTip.Tip="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Export to…" Command="{Binding ExportPackageCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding HasHistory}">
              <TextBlock Text="DUT history" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HistorySeverity, StringFormat=Severity: {0}}" Opacity="0.8" FontSize="12" />
              <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" Opacity="0.9" />
              <Grid ColumnDefinitions="*,70,70,60,60" Margin="0,4,0,0" Opacity="0.7">
                <TextBlock Text="Metric" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Current" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Prior" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Delta" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="4" Text="Sev" FontWeight="SemiBold" FontSize="11" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HistoryMetrics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DutHistoryMetricRow">
                    <Grid ColumnDefinitions="*,70,70,60,60" ColumnSpacing="2" Margin="0,1">
                      <TextBlock Text="{Binding Channel}" TextTrimming="CharacterEllipsis" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding CurrentMeanText}" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="{Binding PriorMeanText}" FontSize="11" />
                      <TextBlock Grid.Column="3" Text="{Binding PercentDeltaText}" FontSize="11" />
                      <TextBlock Grid.Column="4" Text="{Binding Severity}" FontSize="11" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding HasComparison}">
              <TextBlock Text="Compare with previous" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Opacity="0.9" />
              <TextBlock Text="Measurement comparison" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding ComparisonMetrics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RunComparisonRow">
                    <StackPanel Spacing="4" Margin="0,4">
                      <TextBlock Text="{Binding MetricKey}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding CurrentText, StringFormat='This run: {0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding PreviousText, StringFormat='Previous: {0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding DeltaText, StringFormat='Delta: {0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.75"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <widgetsPres:TimingStripView Margin="0,8,0,0"
                                         IsVisible="{Binding HasTimingStrip}"
                                         Events="{Binding TimingEvents}"
                                         Spans="{Binding TimingSpans}"
                                         DurationSec="{Binding TimingDurationSec}" />
            <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasPresentationTiles}">
              <TextBlock Text="Metrics" FontWeight="SemiBold" />
              <TextBlock Text="Band gauges first; expand a timeseries chart only when you need the waveform."
                         Opacity="0.65"
                         FontSize="11"
                         TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding PresentationTiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pres:PresentationTileViewModel">
                    <StackPanel Margin="0,0,0,8" IsVisible="{Binding !IsStrip}">
                      <widgetsPres:MetricGaugeView IsVisible="{Binding IsGauge}" DataContext="{Binding}" />
                      <vm:ResultsChartHost IsVisible="{Binding IsChart}" DataContext="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="Steps" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding FirstFailSummary}"
                       IsVisible="{Binding HasFirstFail}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding TriageSummary}"
                       Opacity="0.8"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding TriageSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowFailedStepsBanner}">
              <TextBlock Text="Showing failed steps only" VerticalAlignment="Center" Opacity="0.85" />
              <Button Content="Show all steps"
                      Command="{Binding ClearFailedStepsFilterCommand}"
                      FontSize="11" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding StepDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Samples" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding SampleDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
               Text="Click a run to open detail. Double-click opens the default report. After a fail, Results filters to Failed and shows failed steps first."
               Opacity="0.55" FontSize="11" />
  </Grid>

    <Border IsVisible="{Binding ShowAttestationPrompt}"
            Background="#CC000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border MaxWidth="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="16"
              CornerRadius="6"
              BorderBrush="#FB8C00"
              BorderThickness="2"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Sign and continue"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding AttestationPromptStatus}"
                     TextWrapping="Wrap"
                     FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
          <TextBox IsVisible="{Binding ShowAttestationPin}"
                   PasswordChar="•"
                   PlaceholderText="Badge PIN"
                   Text="{Binding AttestationPin}"
                   MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                   AutomationProperties.Name="Badge PIN" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Sign and continue"
                    Command="{Binding CaptureAttestationCommand}"
                    Classes="primary"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding !ShowAttestationPin}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Tap or insert badge" />
            <Button Content="Sign"
                    Command="{Binding CaptureAttestationCommand}"
                    Classes="primary"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding ShowAttestationPin}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Sign with badge PIN" />
            <Button Content="Record presence"
                    Command="{Binding UsePresenceAttestationCommand}"
                    Classes="operator"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding AllowPresenceFallback}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Record presence without signing" />
            <Button Content="Cancel"
                    Command="{Binding CancelAttestationCommand}"
                    Classes="operator"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsEnabled="{Binding !IsCapturingAttestation}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
