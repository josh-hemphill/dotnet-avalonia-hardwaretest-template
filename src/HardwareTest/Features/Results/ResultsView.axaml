<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Results"
             xmlns:runVm="using:HardwareTest.Features.RunTest"
             xmlns:runs="using:HardwareTest.Core.Runs"
             xmlns:pres="using:HardwareTest.Features.Presentation"
             xmlns:storage="using:HardwareTest.Core.Storage"
             xmlns:widgetsPres="using:HardwareTest.Widgets.Presentation"
             xmlns:conv="using:HardwareTest.Converters"
             xmlns:shell="using:HardwareTest.Features.Shell"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="HardwareTest.Features.Results.ResultsView"
             x:Name="Root"
             x:DataType="vm:ResultsViewModel">
  <Grid KeyDown="OnResultsKeyDown">
  <Grid x:Name="ResultsLayout" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,0" ColumnSpacing="12" RowSpacing="10">
    <StackPanel Grid.ColumnSpan="2" Spacing="6">
      <WrapPanel>
      <Button Content="Refresh" Command="{Binding RefreshCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Command="{Binding OpenDefaultReportCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              AutomationProperties.Name="Open report"
              ToolTip.Tip="Open the default PDF for the selected run (double-click the row also works)">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:FASymbolIcon Symbol="{x:Static ui:FASymbol.DocumentFilled}" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="Open report" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ReprintCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              AutomationProperties.Name="Regenerate reports"
              IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="{x:Static vm:ResultsViewModel.RegenerateReportsTip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:FASymbolIcon Symbol="{x:Static ui:FASymbol.Document}" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="Regenerate reports" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      </WrapPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Results status" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <DockPanel x:Name="ResultsListPane" Grid.Row="1">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBlock x:Name="ResultsSearchLabel" Text="Search results" FontWeight="SemiBold"/>
        <TextBox x:Name="ResultsSearchBox" PlaceholderText="Plan, DUT, operator or run ID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                 AutomationProperties.Name="Search results" AutomationProperties.LabeledBy="{Binding #ResultsSearchLabel}"/>
        <Expander Header="{Binding FilterHeading}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Result filters">
          <WrapPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,10,10">
                <TextBlock x:Name="ResultFilterLabel" Text="Result"/>
                <ComboBox ItemsSource="{Binding ResultFilterOptions}" SelectedItem="{Binding ResultFilter}" MinHeight="40"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Filter results by result"
                          AutomationProperties.LabeledBy="{Binding #ResultFilterLabel}"/>
              </StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,10,10">
                <TextBlock x:Name="PlanFilterLabel" Text="Plan"/>
                <ComboBox ItemsSource="{Binding PlanFilterOptions}" SelectedItem="{Binding PlanFilter}" MinHeight="40"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Filter results by plan"
                          AutomationProperties.LabeledBy="{Binding #PlanFilterLabel}"/>
              </StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,10,10">
                <TextBlock x:Name="DUTFilterLabel" Text="DUT"/>
                <ComboBox ItemsSource="{Binding DutFilterOptions}" SelectedItem="{Binding DutFilter}" MinHeight="40"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Filter results by dut"
                          AutomationProperties.LabeledBy="{Binding #DUTFilterLabel}"/>
              </StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,10,10">
                <TextBlock x:Name="OperatorFilterLabel" Text="Operator"/>
                <ComboBox ItemsSource="{Binding OperatorFilterOptions}" SelectedItem="{Binding OperatorFilter}" MinHeight="40"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Filter results by operator"
                          AutomationProperties.LabeledBy="{Binding #OperatorFilterLabel}"/>
              </StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,10,10">
                <TextBlock x:Name="DateFilterLabel" Text="Date"/>
                <ComboBox ItemsSource="{Binding DateFilterOptions}" SelectedItem="{Binding DateFilter}" MinHeight="40"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Filter results by date"
                          AutomationProperties.LabeledBy="{Binding #DateFilterLabel}"/>
              </StackPanel>
          </WrapPanel>
        </Expander>
        <WrapPanel>
          <TextBlock Text="{Binding FilterStatus}" TextWrapping="Wrap" MaxWidth="540" VerticalAlignment="Center" Margin="0,0,10,4"/>
          <Button Content="Clear search and filters" Command="{Binding ClearFiltersCommand}" Classes="operator" IsVisible="{Binding HasActiveFilters}"
                  AutomationProperties.Name="Clear result filters"/>
        </WrapPanel>
        <TextBlock Text="{Binding SchemaDriftSummary}" IsVisible="{Binding HasSchemaDrift}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border DockPanel.Dock="Top" Padding="16" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              IsVisible="{Binding !HasRuns}" Margin="0,0,0,8">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding EmptyResultsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
          <TextBlock Text="{Binding EmptyResultsHint}" TextWrapping="Wrap"/>
          <Button Content="Go to Run" Command="{Binding NavigateToRunCommand}" Classes="operator" HorizontalAlignment="Left" IsVisible="{Binding !HasStoredRuns}"/>
          <Button Content="Clear search and filters" Command="{Binding ClearFiltersCommand}" Classes="operator" HorizontalAlignment="Left"
                  IsVisible="{Binding HasStoredRuns}" AutomationProperties.Name="Clear unmatched results search and filters"/>
        </StackPanel>
      </Border>
      <vm:ResultsListBox x:Name="RunResultsList" ItemsSource="{Binding Runs}" Classes="operator-list" SelectedItem="{Binding SelectedRun}" IsVisible="{Binding HasRuns}"
               Tapped="OnRunsTapped" DoubleTapped="OnRunsDoubleTapped" Focusable="True"
               AutomationProperties.Name="Saved runs" MinHeight="40" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="runs:TestRunSummary">
            <Setter Property="AutomationProperties.Name">
              <MultiBinding StringFormat="{}{0}, DUT {1}, {2}, {3}">
                <Binding Path="PlanName"/><Binding Path="DutSerial"/><Binding Path="Result"/><Binding Path="ExecutionScopeText"/>
              </MultiBinding>
            </Setter>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="runs:TestRunSummary">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PlanName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ExecutionScopeText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DutSerial, StringFormat='DUT: {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="Read-only schema" IsVisible="{Binding IsSchemaReadOnly}" TextWrapping="Wrap" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top"
                      Background="{Binding Result, Converter={x:Static runVm:ChipBrushConverter.Instance}}">
                <TextBlock Text="{Binding Result}" Foreground="White" FontWeight="SemiBold"/>
              </Border>
              <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                <TextBlock Text="{Binding DutPartNumber, StringFormat='Part: {0}'}" MaxWidth="220" TextWrapping="Wrap" Margin="0,0,16,4"/>
                <TextBlock Text="{Binding OperatorName, StringFormat='Operator: {0}'}" MaxWidth="220" TextWrapping="Wrap" Margin="0,0,16,4"/>
                <TextBlock Text="{Binding SessionId, Converter={x:Static conv:ShortIdConverter.Instance}, StringFormat='Session: {0}'}" ToolTip.Tip="{Binding SessionId}" Margin="0,0,16,4"/>
                <TextBlock Text="{Binding StartedAt, StringFormat='Started: {0}'}" MaxWidth="280" TextWrapping="Wrap" Margin="0,0,16,4"/>
              </WrapPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </vm:ResultsListBox>
    </DockPanel>
    <Border x:Name="ResultsDetailPane" Grid.Row="1" Grid.Column="1"
            IsVisible="{Binding ShowDetail}"
            Padding="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <!-- Verdict, scope and navigation remain visible while secondary identity is disclosed. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding OpenedRun.PlanName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding OpenedRun.PlanName}" />
            <Button x:Name="ResultsCloseButton" Grid.Column="1" Content="Back to results" Command="{Binding CloseDetailCommand}" Classes="operator" AutomationProperties.Name="Close run details"/>
          </Grid>
          <WrapPanel>
            <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                    Background="{Binding OpenedRun.Result, Converter={x:Static runVm:ChipBrushConverter.Instance}}">
              <TextBlock x:Name="SavedRunVerdict" Text="{Binding OpenedRun.Result, StringFormat='Verdict: {0}'}"
                         Foreground="White" FontWeight="SemiBold"
                         AutomationProperties.Name="{Binding OpenedRun.Result, StringFormat='Verdict: {0}'}" />
            </Border>
            <Button x:Name="RunIdentityButton" Content="Run details" Classes="operator" Margin="0,0,8,4"
                    AutomationProperties.Name="Inspect full saved run details">
              <Button.Flyout>
                <Flyout>
                  <TextBox x:Name="RunIdentityBox" Width="400" MaxWidth="480" MaxHeight="320"
                           Text="{Binding RunIdentityText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           AutomationProperties.Name="Full saved run details" KeyDown="OnRunIdentityKeyDown" />
                </Flyout>
              </Button.Flyout>
            </Button>
            <Border IsVisible="{Binding HasSchemaBadge}" Padding="6,2" Margin="0,0,0,4" CornerRadius="3"
                    Background="{DynamicResource SystemControlBackgroundBaseMediumBrush}" VerticalAlignment="Center">
              <TextBlock Text="{Binding SchemaBadge}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" Opacity="0.9" />
            </Border>
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding OpenedRun.ExecutionScopeText}" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Saved run execution scope"
                     AutomationProperties.HelpText="{Binding OpenedRun.ExecutionScopeText}" ToolTip.Tip="{Binding OpenedRun.ExecutionScopeText}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding OpenedRun.DutSerial, StringFormat=DUT: {0}}" Opacity="0.85" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SchemaWarning}" IsVisible="{Binding HasSchemaWarning}" TextWrapping="Wrap"
                     Opacity="0.85" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
        </StackPanel>

        <ScrollViewer Padding="0,0,4,0">
          <StackPanel Spacing="6">
            <StackPanel Spacing="2" IsVisible="{Binding HasAttestation}">
              <TextBlock Text="Certification" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AttestationSummary}" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding HasReports}">
              <TextBlock Text="Reports" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding ReportItems}" SelectedItem="{Binding SelectedReportItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RunReportItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="8">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding RoleLabel}"
                                     Opacity="0.65"
                                     FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="(default)"
                                     Opacity="0.65"
                                     FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsDefault}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VerificationText}" Opacity="0.7" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Open"
                              Command="{Binding #Root.((vm:ResultsViewModel)DataContext).OpenReportCommand}"
                              CommandParameter="{Binding}"
                              FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                              Margin="0,0,8,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasExportTargets}">
              <TextBlock Text="Export package" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static vm:ResultsViewModel.ExportPackageHelp}"
                         Opacity="0.75" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding ExportTargets}" AutomationProperties.Name="Export destination"
                        SelectedItem="{Binding SelectedExportTarget}"
                        MinWidth="180"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="storage:ExportTarget">
                    <TextBlock Text="{Binding DisplayName}"
                               TextWrapping="Wrap"
                               ToolTip.Tip="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="ResultsExportButton" Content="Export package" Command="{Binding ExportPackageCommand}" HorizontalAlignment="Left"
                      Classes="operator" AutomationProperties.Name="Export package" />
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding HasHistory}">
              <TextBlock Text="DUT history" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HistorySeverity, StringFormat=Severity: {0}}" Opacity="0.8" FontSize="12" />
              <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" Opacity="0.9" />
              <Grid ColumnDefinitions="*,70,70,60,60" Margin="0,4,0,0" Opacity="0.7">
                <TextBlock Text="Metric" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="1" Text="Current" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="2" Text="Prior" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="3" Text="Delta" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="4" Text="Sev" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HistoryMetrics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DutHistoryMetricRow">
                    <Grid ColumnDefinitions="*,70,70,60,60" ColumnSpacing="2" Margin="0,1">
                      <TextBlock Text="{Binding Channel}" TextTrimming="CharacterEllipsis" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="1" Text="{Binding CurrentMeanText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="2" Text="{Binding PriorMeanText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="3" Text="{Binding PercentDeltaText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="4" Text="{Binding Severity}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding HasComparison}">
              <TextBlock Text="Compare with previous" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Opacity="0.9" />
              <Grid ColumnDefinitions="*,80,80,60,*" Margin="0,4,0,0" Opacity="0.7">
                <TextBlock Text="Metric" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="1" Text="This run" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="2" Text="Previous" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="3" Text="Delta" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                <TextBlock Grid.Column="4" Text="Note" FontWeight="SemiBold" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ComparisonMetrics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RunComparisonRow">
                    <Grid ColumnDefinitions="*,80,80,60,*" ColumnSpacing="2" Margin="0,1">
                      <TextBlock Text="{Binding MetricKey}" TextTrimming="CharacterEllipsis" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="1" Text="{Binding CurrentText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="2" Text="{Binding PreviousText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="3" Text="{Binding DeltaText}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                      <TextBlock Grid.Column="4" Text="{Binding Note}" TextTrimming="CharacterEllipsis" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <widgetsPres:TimingStripView Margin="0,8,0,0"
                                         IsVisible="{Binding HasTimingStrip}"
                                         Events="{Binding TimingEvents}"
                                         Spans="{Binding TimingSpans}"
                                         DurationSec="{Binding TimingDurationSec}" />
            <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasPresentationTiles}">
              <TextBlock Text="Metrics" FontWeight="SemiBold" />
              <TextBlock Text="Band gauges first; expand a timeseries chart only when you need the waveform."
                         Opacity="0.65"
                         FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                         TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding PresentationTiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pres:PresentationTileViewModel">
                    <StackPanel Margin="0,0,0,8" IsVisible="{Binding !IsStrip}">
                      <widgetsPres:MetricGaugeView IsVisible="{Binding IsGauge}" DataContext="{Binding}" />
                      <vm:ResultsChartHost IsVisible="{Binding IsChart}" DataContext="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="Steps" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding FirstFailSummary}"
                       IsVisible="{Binding HasFirstFail}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding TriageSummary}"
                       Opacity="0.8"
                       FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding TriageSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel IsVisible="{Binding ShowFailedStepsBanner}">
              <TextBlock Text="Showing failed steps only" VerticalAlignment="Center" Opacity="0.85" />
              <Button Content="Show all steps"
                      Command="{Binding ClearFailedStepsFilterCommand}"
                      FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding StepDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" Margin="0,1" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Samples" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding SampleDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" Margin="0,1" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock x:Name="ResultsNavigationHint" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap"
               Text="Select a run to view its details. Double-click opens its default report."
               Opacity="0.55" FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
  </Grid>

    <Border IsVisible="{Binding ShowAttestationPrompt}"
            Background="#CC000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border x:Name="AttestationPanel" MaxWidth="520" Margin="12"
              KeyboardNavigation.TabNavigation="Cycle"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="16"
              CornerRadius="6"
              BorderBrush="#FB8C00"
              BorderThickness="2"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Sign and continue"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding AttestationPromptStatus}" AutomationProperties.LiveSetting="Polite"
                     TextWrapping="Wrap"
                     FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
          <TextBlock x:Name="AttestationPinLabel" Text="Badge PIN" IsVisible="{Binding ShowAttestationPin}" />
          <TextBox x:Name="AttestationPinBox" IsVisible="{Binding ShowAttestationPin}"
                   PasswordChar="•"
                   PlaceholderText="Badge PIN"
                   Text="{Binding AttestationPin}"
                   MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                   AutomationProperties.Name="Badge PIN" AutomationProperties.LabeledBy="{Binding #AttestationPinLabel}" />
          <WrapPanel>
            <Button x:Name="AttestationCaptureButton" Content="Sign and continue" Margin="0,0,8,8"
                    Command="{Binding CaptureAttestationCommand}"
                    Classes="primary"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding !ShowAttestationPin}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Tap or insert badge" />
            <Button Content="Sign" Margin="0,0,8,8"
                    Command="{Binding CaptureAttestationCommand}"
                    Classes="primary"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding ShowAttestationPin}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Sign with badge PIN" />
            <Button Content="Record presence" Margin="0,0,8,8"
                    Command="{Binding UsePresenceAttestationCommand}"
                    Classes="operator"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    IsVisible="{Binding AllowPresenceFallback}"
                    IsEnabled="{Binding !IsCapturingAttestation}"
                    AutomationProperties.Name="Record presence without signing" />
            <Button Content="Cancel" Margin="0,0,8,8"
                    Command="{Binding CancelAttestationCommand}"
                    Classes="operator"
                    MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
                    AutomationProperties.Name="Cancel report signing" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
