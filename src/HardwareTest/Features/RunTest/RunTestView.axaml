<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.RunTest"
             xmlns:widgets="using:HardwareTest.Widgets.MeasurementPlot"
             x:Class="HardwareTest.Features.RunTest.RunTestView"
             x:DataType="vm:RunTestViewModel"
             KeyDown="OnKeyDown">
  <Grid ColumnDefinitions="*,200" ColumnSpacing="12" RowDefinitions="Auto,Auto,*">
    <Border Grid.ColumnSpan="2"
            Padding="10,8"
            Margin="0,0,0,8"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Program" VerticalAlignment="Center" Opacity="0.8" />
          <ComboBox ItemsSource="{Binding Programs}"
                    SelectedItem="{Binding SelectedProgram}"
                    MinWidth="260"
                    MaxDropDownHeight="320"
                    IsEnabled="{Binding !IsRunning}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProgramItemViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Refresh" Command="{Binding RefreshProgramsCommand}" />
          <Button Content="Open…" Command="{Binding OpenPlanFileCommand}"
                  IsVisible="{Binding IsEngineerDebugMode}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Run" Command="{Binding RunCommand}"
                  IsEnabled="{Binding !SessionBlocked}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Inspect" Command="{Binding InspectPlanCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Value="{Binding OverallPercent}"
                 Minimum="0"
                 Maximum="100"
                 Height="5"
                 Margin="0,0,0,4"
                 HorizontalAlignment="Stretch" />

    <Grid Grid.Row="2" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="0">
      <Border Padding="8,6"
              Margin="0,0,0,4"
              CornerRadius="6"
              BorderBrush="#FB8C00"
              BorderThickness="2"
              IsVisible="{Binding SessionBlocked}">
        <StackPanel Spacing="6">
          <TextBlock Text="Session confirmation required before Run"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" Opacity="0.9" />
          <StackPanel Spacing="6" IsVisible="{Binding IsStalePrompt}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Still testing this DUT?" VerticalAlignment="Center" />
              <Button Content="Same DUT" Command="{Binding ConfirmSameDutCommand}" />
              <Button Content="Change Session" Command="{Binding ChangeSessionCommand}" />
            </StackPanel>
          </StackPanel>
          <WrapPanel IsVisible="{Binding NeedsDutConfirm}">
            <TextBox PlaceholderText="DUT serial *" Text="{Binding DutSerialInput}"
                     Width="150" Margin="0,0,8,8" />
            <TextBox PlaceholderText="Part number" Text="{Binding DutPartInput}"
                     Width="130" Margin="0,0,8,8"
                     IsVisible="{Binding RequirePartNumber}" />
            <TextBox PlaceholderText="Revision" Text="{Binding DutRevisionInput}"
                     Width="90" Margin="0,0,8,8"
                     IsVisible="{Binding RequireRevision}" />
            <TextBox PlaceholderText="Technician *" Text="{Binding OperatorInput}"
                     Width="140" Margin="0,0,8,8" />
            <Button Content="Confirm Session" Command="{Binding ConfirmSessionCommand}"
                    Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Padding="8,6"
              Margin="0,0,0,4"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              IsVisible="{Binding !SessionBlocked}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding SessionSummary}"
                     FontWeight="SemiBold"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Change" Command="{Binding ChangeSessionCommand}"
                  FontSize="11" Padding="8,2" />
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="8,6"
              Margin="0,2,0,2"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="2">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,2">
              <TextBlock Text="{Binding HeroLabel}" Opacity="0.7" VerticalAlignment="Center" FontSize="12" />
              <TextBlock Text="{Binding HeroStepName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <Border CornerRadius="4"
                      Padding="8,2"
                      VerticalAlignment="Center"
                      Background="{Binding HeroChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                <TextBlock Text="{Binding HeroChipText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
              </Border>
              <Button Content="Jump to current" Command="{Binding JumpToCurrentCommand}"
                      IsVisible="{Binding IsRunning}" FontSize="11" Padding="6,2" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2" VerticalAlignment="Center">
              <Button Content="{Binding BreadcrumbText}"
                      Command="{Binding ClearSubsectionCommand}"
                      FontSize="11"
                      Padding="4,2" />
              <TextBlock Text="{Binding BreadcrumbDetailText}"
                         Opacity="0.75"
                         FontSize="11"
                         VerticalAlignment="Center" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding HeroStatusLine}"
                     Opacity="0.85"
                     TextWrapping="Wrap"
                     FontSize="11"
                     IsVisible="{Binding !IsAwaitingOperator}" />
          <Border IsVisible="{Binding IsAwaitingOperator}"
                  BorderBrush="#FB8C00"
                  BorderThickness="2"
                  CornerRadius="4"
                  Padding="8"
                  Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding InteractionTitle}"
                         FontWeight="Bold"
                         FontSize="13" />
              <TextBlock Text="{Binding OperatorPromptMessage}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding InteractionValidationError}"
                         Foreground="#E65100"
                         TextWrapping="Wrap"
                         FontSize="12"
                         IsVisible="{Binding InteractionValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ItemsControl ItemsSource="{Binding InteractionFields}"
                            IsVisible="{Binding HasInteractionFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InteractionFieldViewModel">
                    <StackPanel Spacing="4" Margin="0,2,0,4">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="12"
                                 Opacity="0.85"
                                 IsVisible="{Binding IsTextOrNumber}" />
                      <TextBox Text="{Binding Value}"
                               PlaceholderText="{Binding ValidationHint}"
                               IsVisible="{Binding IsTextOrNumber}" />
                      <CheckBox Content="{Binding Label}"
                                IsChecked="{Binding BoolValue}"
                                IsVisible="{Binding IsBoolean}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Continue"
                      Command="{Binding ContinueOperatorCommand}"
                      Classes="success"
                      HorizontalAlignment="Left"
                      MinWidth="120" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
        <Button Content="Run Selected" Command="{Binding RunSelectedCommand}"
                IsEnabled="{Binding !SessionBlocked}"
                ToolTip.Tip="Run the selected leaf or section (subtree + Safe Shutdown). Use Run for the full suite." />
        <Button Content="Prev fail" Command="{Binding PrevFailCommand}" />
        <Button Content="Next fail" Command="{Binding NextFailCommand}" />
        <ToggleButton Content="Details"
                      IsChecked="{Binding ShowDetailRegion}"
                      Classes="filter-chip"
                      ToolTip.Tip="Show or hide bottom pane (detail, plot, diagnostics)" />
      </StackPanel>

      <Border Grid.Row="3"
              Padding="6,4"
              Margin="0,0,0,6"
              CornerRadius="6"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Show"
                     Opacity="0.65"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="2,0,4,0" />
          <Button Classes="filter-chip" Content="All"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.All}" />
          <Button Classes="filter-chip" Content="Fail"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.Fail}" />
          <Button Classes="filter-chip" Content="Running"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.Running}" />
          <Button Classes="filter-chip" Content="Pending"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.Pending}" />
          <ToggleButton Content="Compact"
                        IsChecked="{Binding CompactStepRows}"
                        Classes="filter-chip"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Tighter step-list row spacing" />
          <TextBox x:Name="StepSearchBox"
                   PlaceholderText="Search steps…"
                   Text="{Binding StepSearchText}"
                   Width="180"
                   MinHeight="28"
                   Margin="8,0,0,0" />
        </StackPanel>
      </Border>

      <ListBox x:Name="StepList"
               Grid.Row="4"
               ItemsSource="{Binding StepListItems}"
               SelectedItem="{Binding SelectedStepListItem}"
               DoubleTapped="OnHierarchyDoubleTapped"
               Margin="0,0,0,4"
               Classes.compact="{Binding CompactStepRows}">
        <ListBox.Styles>
          <Style Selector="ListBox.compact ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="28" />
          </Style>
          <Style Selector="ListBox.compact TextBlock">
            <Setter Property="FontSize" Value="11" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StepListItemViewModel">
            <Panel>
              <Border IsVisible="{Binding IsHeader}"
                      Margin="0,8,0,2"
                      Padding="0,3,0,4"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                      BorderThickness="0,0,0,1"
                      ToolTip.Tip="Select this section, then Run Selected to execute its steps">
                <DockPanel LastChildFill="True">
                  <Border DockPanel.Dock="Left"
                          Width="3"
                          Margin="0,1,8,1"
                          CornerRadius="1"
                          Background="{DynamicResource SystemAccentColor}"
                          Opacity="0.85" />
                  <TextBlock Text="{Binding DisplayName}"
                             FontWeight="SemiBold"
                             FontSize="11"
                             Opacity="0.78"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
              <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8"
                    IsVisible="{Binding !IsHeader}">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        CornerRadius="4"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{Binding ChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                  <TextBlock Text="{Binding ChipText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding KeyValue}" Opacity="0.8" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding AttemptsText}" FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" />
              </Grid>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Row="5"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows"
                    IsVisible="{Binding ShowDetailRegion}"
                    Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

      <!-- Whole bottom tray collapses with Details (detail + diagnostics + debug). Auto height so list * expands. -->
      <ScrollViewer Grid.Row="6"
                    IsVisible="{Binding ShowDetailRegion}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="360">
        <StackPanel Spacing="8" Margin="0,0,0,4">
          <Border Padding="8"
                  MinHeight="120"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Step detail"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="Results" Command="{Binding OpenLastRunResultsCommand}" />
                <Button Content="Hide"
                        Command="{Binding CloseDetailCommand}"
                        FontSize="11" />
              </StackPanel>
              <TextBlock Text="{Binding DetailPrimaryLine}"
                         TextWrapping="Wrap"
                         Opacity="0.9" />
              <TextBlock Text="{Binding AttemptSummaryChip, StringFormat=Attempts: {0}}"
                         IsVisible="{Binding AttemptSummaryChip, Converter={x:Static ObjectConverters.IsNotNull}}"
                         FontWeight="SemiBold"
                         Opacity="0.9" />
              <ListBox ItemsSource="{Binding AttemptHistoryLines}"
                       MaxHeight="140"
                       MinHeight="48"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <widgets:MeasurementPlotView x:Name="Plot"
                                           Height="140"
                                           IsVisible="{Binding ShowPlotForSelection}" />
              <TextBlock Text="{Binding DetailStep.Path, StringFormat=Path: {0}}"
                         FontSize="11"
                         Opacity="0.55"
                         TextWrapping="Wrap" />
              <Border IsVisible="{Binding IsEngineerDebugMode}"
                      Padding="8"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <StackPanel Spacing="2">
                  <TextBlock Text="Conditions applied" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="{Binding ConditionSummary}" TextWrapping="Wrap" Opacity="0.9" />
                </StackPanel>
              </Border>
              <Border IsVisible="{Binding HasParameterFields}"
                      Padding="8"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Station overrides"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Content="Apply &amp; save"
                            Command="{Binding ApplyParametersCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            FontSize="11" />
                  </StackPanel>
                  <TextBlock Text="Engineer/Debug only. Persists bench settings — does not rewrite the TapPlan. Operator-entered values still come from mid-run prompts."
                             FontSize="11"
                             Opacity="0.65"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ParameterFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InteractionFieldViewModel">
                        <StackPanel Spacing="4" Margin="0,2,0,4">
                          <TextBlock Text="{Binding Label}"
                                     FontSize="12"
                                     Opacity="0.85"
                                     IsVisible="{Binding IsTextOrNumber}" />
                          <TextBox Text="{Binding Value}"
                                   PlaceholderText="{Binding ValidationHint}"
                                   IsVisible="{Binding IsTextOrNumber}"
                                   IsReadOnly="{Binding IsReadOnly}" />
                          <CheckBox Content="{Binding Label}"
                                    IsChecked="{Binding BoolValue}"
                                    IsVisible="{Binding IsBoolean}"
                                    IsEnabled="{Binding !IsReadOnly}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Expander Header="Diagnostics — Session log"
                    IsExpanded="{Binding SessionLogExpanded}">
            <ListBox ItemsSource="{Binding DetailLines}" MaxHeight="140" MinHeight="60" />
          </Expander>

          <Border Padding="8"
                  IsVisible="{Binding IsEngineerDebugMode}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Debug overlay" FontWeight="SemiBold" VerticalAlignment="Center" />
              <CheckBox Content="Enabled" IsChecked="{Binding DebugStepEnabled}" />
              <TextBox PlaceholderText="Resource" Text="{Binding DebugResource}" Width="140" />
              <NumericUpDown Value="{Binding DebugSampleCount}" Minimum="1" Maximum="4096" Width="90" FormatString="0" />
              <NumericUpDown Value="{Binding DebugIntervalMs}" Minimum="1" Maximum="60000" Width="90" FormatString="0" />
              <Button Content="Apply" Command="{Binding ApplyDebugPatchCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="2" Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
        <TextBlock Text="Suite"
                   Opacity="0.65"
                   FontSize="11"
                   FontWeight="SemiBold" />
        <WrapPanel Orientation="Horizontal">
          <Button Classes="filter-chip"
                  Content="{Binding SuitePassedCount, StringFormat=Passed {0}}"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.All}"
                  Margin="0,0,4,4" />
          <Button Classes="filter-chip"
                  Content="{Binding SuiteFailedCount, StringFormat=Failed {0}}"
                  Command="{Binding FilterFailCommand}"
                  Margin="0,0,4,4" />
          <Button Classes="filter-chip"
                  Content="{Binding SuitePendingCount, StringFormat=Pending {0}}"
                  Command="{Binding SetStepFilterCommand}"
                  CommandParameter="{x:Static vm:StepStatusFilter.Pending}"
                  Margin="0,0,4,4" />
        </WrapPanel>
        <TextBlock Text="Stages" FontWeight="SemiBold" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
        <StackPanel Spacing="6" IsVisible="{Binding HasSubsections}">
          <TextBlock Text="Sections" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Subsections}"
                   SelectedItem="{Binding SelectedSubsection}"
                   MaxHeight="140">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StageItemViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="4"
                            Padding="6,1"
                            Background="{Binding ChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                      <TextBlock Text="{Binding ChipText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="3" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding HasNestedSubsections}">
          <TextBlock Text="Subsections" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding NestedSubsections}"
                   SelectedItem="{Binding SelectedNestedSubsection}"
                   MaxHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StageItemViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="4"
                            Padding="6,1"
                            Background="{Binding ChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                      <TextBlock Text="{Binding ChipText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="3" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
      <ListBox ItemsSource="{Binding Stages}"
               SelectedItem="{Binding SelectedStage}"
               DoubleTapped="OnStageDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StageItemViewModel">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="4"
                        Padding="6,1"
                        Background="{Binding ChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                  <TextBlock Text="{Binding ChipText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
              <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="3" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
