<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.RunTest"
             x:Class="HardwareTest.Features.RunTest.RunTestView"
             x:DataType="vm:RunTestViewModel"
             KeyDown="OnKeyDown">
  <Grid RowDefinitions="Auto,5,*">
    <Border Padding="10,8"
            Margin="0,0,0,8"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <vm:RunHeaderView />
    </Border>

    <ProgressBar Grid.Row="1"
                 Value="{Binding OverallPercent}"
                 Minimum="0"
                 Maximum="100"
                 Height="5"
                 HorizontalAlignment="Stretch"
                 IsHitTestVisible="False"
                 Opacity="{Binding ShowOverallProgress, Converter={x:Static vm:BoolToOpacityConverter.Instance}}" />

    <Panel Grid.Row="2">
      <vm:RunPreparationView IsVisible="{Binding Workspace.ShowPreparation}" />
      <vm:InteractionHostView IsVisible="{Binding Workspace.ShowInteraction}" />
      <vm:RunStepsWorkspaceView IsVisible="{Binding Workspace.ShowSteps}" />
      <vm:RunDetailsWorkspaceView IsVisible="{Binding Workspace.ShowDetails}" />
      <vm:RunChartWorkspaceView IsVisible="{Binding Workspace.ShowChart}" />
    </Panel>
  </Grid>
</UserControl>
