<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.RunTest"
             xmlns:shell="using:HardwareTest.Features.Shell"
             x:Class="HardwareTest.Features.RunTest.RunStepsWorkspaceView"
             x:DataType="vm:RunTestViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
    <StackPanel>
    <ListBox ItemsSource="{Binding StepTree.Stages}"
             SelectedItem="{Binding StepTree.SelectedStage}"
             IsVisible="{Binding Workspace.ShowInlineStageChips}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StageItemViewModel">
          <StackPanel Spacing="2" Margin="0,0,8,4">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProgressText}"
                       FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                       Opacity="0.75" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
      <ComboBox ItemsSource="{Binding StepTree.Stages}"
                SelectedItem="{Binding StepTree.SelectedStage}"
                MinWidth="160"
                MaxDropDownHeight="280"
                IsVisible="{Binding IsCompactLayout}"
                PlaceholderText="Stage"
                AutomationProperties.Name="Stage">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StageItemViewModel">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding StepTree.BreadcrumbText}"
              Command="{Binding StepTree.ClearSubsectionCommand}"
              FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
              Padding="8,4"
              Classes="operator" />
      <TextBlock Text="{Binding StepTree.BreadcrumbDetailText}"
                 Opacity="0.75"
                 FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <WrapPanel Grid.Row="2">
      <Button Content="Run Selected"
              Command="{Binding Run.RunSelectedCommand}"
              Classes="operator"
              Margin="0,0,8,4"
              IsEnabled="{Binding CanStartRun}"
              IsVisible="{Binding !IsRunning}"
              ToolTip.Tip="{Binding CanStartRunSelectedTip}" />
      <ToggleButton Classes="filter-chip" Content="All"
                    Margin="0,0,4,4"
                    IsChecked="{Binding StepTree.IsFilterAll, Mode=OneWay}"
                    Command="{Binding StepTree.SetStepFilterCommand}"
                    CommandParameter="{x:Static vm:StepStatusFilter.All}" />
      <ToggleButton Classes="filter-chip" Content="Needs attention"
                    Margin="0,0,4,4"
                    IsChecked="{Binding StepTree.IsFilterFail, Mode=OneWay}"
                    Command="{Binding StepTree.SetStepFilterCommand}"
                    CommandParameter="{x:Static vm:StepStatusFilter.Fail}" />
      <Border CornerRadius="4"
              Padding="8,2"
              Background="#FFCDD2"
              BorderBrush="#C62828"
              BorderThickness="1"
              VerticalAlignment="Center"
              Margin="0,0,4,4"
              IsVisible="{Binding StepTree.IsFilteredToFail}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Showing fails"
                     FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Content="Clear"
                  Command="{Binding StepTree.ClearFailFilterCommand}"
                  FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                  Padding="6,1" />
        </StackPanel>
      </Border>
      <TextBox x:Name="StepSearchBox"
               PlaceholderText="Search steps…"
               Text="{Binding StepTree.StepSearchText}"
               Width="180"
               MinHeight="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}"
               Margin="8,0,8,4"
               IsVisible="{Binding !IsCompactHeight}" />
      <Button Content="More"
              Classes="operator"
              Margin="0,0,8,4">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Previous fail" Command="{Binding StepTree.PrevFailCommand}" />
            <MenuItem Header="Next fail" Command="{Binding StepTree.NextFailCommand}" />
            <MenuItem Header="Compact rows" Command="{Binding StepTree.ToggleCompactCommand}" />
            <MenuItem Header="Show pending"
                      Command="{Binding StepTree.SetStepFilterCommand}"
                      CommandParameter="{x:Static vm:StepStatusFilter.Pending}" />
            <MenuItem Header="Search steps" Command="{Binding StepTree.FocusStepSearchCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </WrapPanel>

    <ListBox x:Name="StepList"
             Grid.Row="3"
             Classes="operator-list"
             ItemsSource="{Binding StepTree.StepListItems}"
             SelectedItem="{Binding StepTree.SelectedStepListItem}"
             DoubleTapped="OnHierarchyDoubleTapped"
             Classes.compact="{Binding StepTree.CompactStepRows}">
      <ListBox.Styles>
        <Style Selector="ListBox.compact ListBoxItem">
          <Setter Property="Padding" Value="6,4" />
          <Setter Property="MinHeight" Value="{x:Static shell:OperatorTouchDensity.OperatorControlMinHeight}" />
        </Style>
        <Style Selector="ListBox.compact TextBlock">
          <Setter Property="FontSize" Value="{x:Static shell:OperatorTouchDensity.OperationalFontSize}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StepListItemViewModel">
          <Panel>
            <Border IsVisible="{Binding IsHeader}"
                    Margin="0,8,0,2"
                    Padding="0,3,0,4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        Width="3"
                        Margin="0,1,8,1"
                        CornerRadius="1"
                        Background="{DynamicResource SystemAccentColor}"
                        Opacity="0.85" />
                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                           Opacity="0.78"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsHeader}">
              <Border CornerRadius="4"
                      Padding="8,2"
                      VerticalAlignment="Center"
                      Background="{Binding Step.ChipText, Converter={x:Static vm:ChipBrushConverter.Instance}}">
                <TextBlock Text="{Binding Step.ChipText}"
                           FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                           FontWeight="SemiBold"
                           Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Step.KeyValue}"
                           Opacity="0.8"
                           FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Text="{Binding Step.AttemptsText}"
                         FontWeight="SemiBold"
                         FontSize="{x:Static shell:OperatorTouchDensity.OperationalFontSize}"
                         VerticalAlignment="Center" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
