<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.ReportPreview"
             x:Class="HardwareTest.Features.ReportPreview.ReportPreviewView"
             x:DataType="vm:ReportPreviewViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Back to Results" Command="{Binding NavigateToResultsCommand}"
              Classes="operator" />
      <Button Content="Load Latest Report" Command="{Binding LoadLatestCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Sign report" Command="{Binding SignCommand}" IsEnabled="{Binding !IsBusy}" />
      <Button Content="Save a copy" Command="{Binding SaveCopyCommand}" IsEnabled="{Binding !IsBusy}" />
      <Button Content="Open in PDF viewer" Command="{Binding OpenInViewerCommand}" IsEnabled="{Binding !IsBusy}" />
      <Button Content="Print…" Command="{Binding PrintCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Cancel print" Command="{Binding CancelPrintCommand}" IsVisible="{Binding IsPrinting}" />
      <TextBlock Text="Loading…"
                 IsVisible="{Binding IsBusy}"
                 VerticalAlignment="Center"
                 Opacity="0.8"
                 FontWeight="SemiBold" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" />
      <TextBlock Text="Save a copy preserves the original digital signature. Printing to PDF creates a new document. Choose a destination outside the managed run folder."
                 TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="{Binding PrintStatus}" TextWrapping="Wrap" />
      <Border IsVisible="{Binding ShowSigningPrompt}" Padding="12" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SigningPromptStatus}" TextWrapping="Wrap" />
          <TextBox IsVisible="{Binding ShowSigningPin}" Text="{Binding SigningPin}" PasswordChar="*"
                   PlaceholderText="Badge PIN" MaxWidth="220" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SignButtonLabel}" Command="{Binding SignAndContinueCommand}" />
            <Button Content="Use presence attestation" Command="{Binding UsePresenceCommand}"
                    IsVisible="{Binding AllowPresenceFallback}" />
            <Button Content="Cancel" Command="{Binding CancelSigningCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Grid.Row="2"
            Padding="16"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            IsVisible="{Binding ShowEmptyState}"
            VerticalAlignment="Top">
      <StackPanel Spacing="12" MaxWidth="520">
        <TextBlock Text="No PDF loaded — open a run from Results, or load the latest report."
                   TextWrapping="Wrap"
                   Opacity="0.85" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Load Latest Report" Command="{Binding LoadLatestCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Content="Go to Results" Command="{Binding NavigateToResultsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !ShowEmptyState}">
      <ItemsControl ItemsSource="{Binding Pages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" BorderBrush="#33000000" BorderThickness="1">
              <Image Source="{Binding}" Stretch="Uniform" MaxWidth="900" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
