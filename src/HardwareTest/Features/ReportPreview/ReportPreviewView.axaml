<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.ReportPreview"
             x:Class="HardwareTest.Features.ReportPreview.ReportPreviewView"
             x:DataType="vm:ReportPreviewViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Load Latest Report" Command="{Binding LoadLatestCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Print" Command="{Binding PrintCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <TextBlock Text="Loading…"
                 IsVisible="{Binding IsBusy}"
                 VerticalAlignment="Center"
                 Opacity="0.8"
                 FontWeight="SemiBold" />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="16"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            IsVisible="{Binding ShowEmptyState}"
            VerticalAlignment="Top">
      <StackPanel Spacing="12" MaxWidth="520">
        <TextBlock Text="No PDF loaded — open a run from Results, or load the latest report."
                   TextWrapping="Wrap"
                   Opacity="0.85" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Load Latest Report" Command="{Binding LoadLatestCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Content="Go to Results" Command="{Binding NavigateToResultsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !ShowEmptyState}">
      <ItemsControl ItemsSource="{Binding Pages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" BorderBrush="#33000000" BorderThickness="1">
              <Image Source="{Binding}" Stretch="Uniform" MaxWidth="900" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
