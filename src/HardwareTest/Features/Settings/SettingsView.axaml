<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Settings"
             xmlns:conv="using:HardwareTest.Converters"
             x:Class="HardwareTest.Features.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,16,12" MaxWidth="920">
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Theme, engineer options, storage gates, and About. Save writes writable fields to settings.json; env/CLI overlays stay out of the file."
                 TextWrapping="Wrap"
                 Opacity="0.8" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save all settings" Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Writes writable Settings fields to settings.json" />
        <TextBlock Text="Saving…"
                   IsVisible="{Binding IsBusy}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Opacity="0.8" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="10" Margin="0,0,16,0" MaxWidth="920">
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="DataDirectoryLabel" Text="Data directory" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding DataDirectory}" IsReadOnly="True"
                   AutomationProperties.LabeledBy="{Binding #DataDirectoryLabel}"
                   AutomationProperties.Name="Data directory" />
        </Grid>

        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="ThemeLabel" Text="Theme" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding ThemePreference}"
                    IsEnabled="{Binding !ThemePreferenceReadOnly}"
                    MinWidth="160"
                    AutomationProperties.LabeledBy="{Binding #ThemeLabel}"
                    AutomationProperties.Name="Theme" />
        </Grid>

        <CheckBox Content="Engineer / debug mode"
                  IsChecked="{Binding IsEngineerDebugMode}"
                  IsEnabled="{Binding !IsEngineerDebugModeReadOnly}"
                  ToolTip.Tip="Unlocks mock VISA, logging sinks, on-bench overlays, and opening arbitrary .TapPlan files" />

        <StackPanel Spacing="10" IsVisible="{Binding IsEngineerDebugMode}">
          <CheckBox Content="Use mock VISA"
                    IsChecked="{Binding UseMockVisa}"
                    IsEnabled="{Binding !UseMockVisaReadOnly}"
                    ToolTip.Tip="Applies immediately when idle (no active run or open VISA session). Refused flips revert this checkbox. When off, demo MOCK:: resources cannot run." />

          <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
            <TextBlock x:Name="LogLevelLabel" Text="Log level" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LogLevelOptions}"
                      SelectedItem="{Binding LogMinimumLevel}"
                      IsEnabled="{Binding !LogMinimumLevelReadOnly}"
                      MinWidth="160"
                      AutomationProperties.LabeledBy="{Binding #LogLevelLabel}"
                      AutomationProperties.Name="Log level" />
          </Grid>

          <CheckBox Content="Windows Event Log"
                    IsVisible="{Binding ShowEventLogOptions}"
                    IsChecked="{Binding EnableOsEventSink}"
                    IsEnabled="{Binding !EnableOsEventSinkReadOnly}" />

          <StackPanel Spacing="10" IsVisible="{Binding ShowSyslogOptions}">
            <CheckBox Content="Unix Syslog"
                      IsChecked="{Binding EnableSyslogOnUnix}"
                      IsEnabled="{Binding !EnableSyslogOnUnixReadOnly}" />
            <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
              <TextBlock x:Name="SyslogHostLabel" Text="Syslog host" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SyslogHost}"
                       IsReadOnly="{Binding SyslogHostReadOnly}"
                       AutomationProperties.LabeledBy="{Binding #SyslogHostLabel}"
                       AutomationProperties.Name="Syslog host" />
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
              <TextBlock x:Name="SyslogPortLabel" Text="Syslog port" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SyslogPort}"
                       IsReadOnly="{Binding SyslogPortReadOnly}"
                       AutomationProperties.LabeledBy="{Binding #SyslogPortLabel}"
                       AutomationProperties.Name="Syslog port" />
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
            <TextBlock x:Name="PlotRefreshLabel" Text="Plot refresh Hz" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding PlotRefreshHz}"
                     IsReadOnly="{Binding PlotRefreshHzReadOnly}"
                     AutomationProperties.LabeledBy="{Binding #PlotRefreshLabel}"
                     AutomationProperties.Name="Plot refresh Hz" />
          </Grid>

          <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
            <TextBlock x:Name="IdleMinutesLabel" Text="DUT session idle (minutes)" VerticalAlignment="Center"
                       ToolTip.Tip="Idle window before Soft-warn → Stale. Default 240 (4 hours). High-throughput lines may use shorter values." />
            <TextBox Grid.Column="1" Text="{Binding OperatorSessionIdleMinutes}"
                     IsReadOnly="{Binding OperatorSessionIdleMinutesReadOnly}"
                     AutomationProperties.LabeledBy="{Binding #IdleMinutesLabel}"
                     AutomationProperties.Name="DUT session idle (minutes)" />
          </Grid>
          <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
            <TextBlock x:Name="IdleWarnLabel" Text="Idle soft-warn %" VerticalAlignment="Center"
                       ToolTip.Tip="Warn when idle elapsed reaches this percent of the idle window (50–95, default 80)." />
            <TextBox Grid.Column="1" Text="{Binding OperatorSessionIdleWarnPercent}"
                     IsReadOnly="{Binding OperatorSessionIdleWarnPercentReadOnly}"
                     AutomationProperties.LabeledBy="{Binding #IdleWarnLabel}"
                     AutomationProperties.Name="Idle soft-warn %" />
          </Grid>
          <CheckBox Content="Confirm DUT every run"
                    IsChecked="{Binding RequireDutConfirmEveryRun}"
                    IsEnabled="{Binding !RequireDutConfirmEveryRunReadOnly}"
                    ToolTip.Tip="After each terminal run, require Same DUT / Change Session before the next Run." />
        </StackPanel>

        <CheckBox Content="Embed plots in report"
                  IsChecked="{Binding EmbedPlotsInReport}"
                  IsEnabled="{Binding !EmbedPlotsInReportReadOnly}" />

        <CheckBox Content="Export OpenTAP results (CSV)"
                  IsChecked="{Binding ExportOpenTapResults}"
                  IsEnabled="{Binding !ExportOpenTapResultsReadOnly}"
                  ToolTip.Tip="Writes published OpenTAP result tables under runs/{runId}/opentap-results/ for MES/QA handoff. Typst PDF is unchanged." />

        <CheckBox Content="DUT history on Run board"
                  IsChecked="{Binding ShowDutHistoryOnRun}"
                  IsEnabled="{Binding !ShowDutHistoryOnRunReadOnly}"
                  ToolTip.Tip="When off (default), history appears only on Results. When on, show a summary banner on Run after Pass/Fail." />

        <Separator Margin="0,8" />

        <TextBlock Text="Storage" FontWeight="SemiBold" />
        <TextBlock Text="Retention and free-space gates for the data directory. Critical free space blocks new runs."
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="RetentionDaysLabel" Text="Retention days" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding RunRetentionDays}"
                   IsReadOnly="{Binding RunRetentionDaysReadOnly}"
                   ToolTip.Tip="0 disables age-based retention"
                   AutomationProperties.LabeledBy="{Binding #RetentionDaysLabel}"
                   AutomationProperties.Name="Retention days" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="MaxRunsLabel" Text="Max retained runs" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding RunRetentionMaxRuns}"
                   IsReadOnly="{Binding RunRetentionMaxRunsReadOnly}"
                   ToolTip.Tip="0 disables count-based retention"
                   AutomationProperties.LabeledBy="{Binding #MaxRunsLabel}"
                   AutomationProperties.Name="Max retained runs" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="ExportDirectoryLabel" Text="Export directory" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding ExportDirectory}"
                   IsReadOnly="{Binding ExportDirectoryReadOnly}"
                   PlaceholderText="Optional fixed export path"
                   AutomationProperties.LabeledBy="{Binding #ExportDirectoryLabel}"
                   AutomationProperties.Name="Export directory" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="WarnFreeLabel" Text="Warn free space (GB)" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding DataFreeSpaceWarnGb}"
                   IsReadOnly="{Binding DataFreeSpaceWarnGbReadOnly}"
                   AutomationProperties.LabeledBy="{Binding #WarnFreeLabel}"
                   AutomationProperties.Name="Warn free space (GB)" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock x:Name="CriticalFreeLabel" Text="Critical free space (GB)" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding DataFreeSpaceCriticalGb}"
                   IsReadOnly="{Binding DataFreeSpaceCriticalGbReadOnly}"
                   AutomationProperties.LabeledBy="{Binding #CriticalFreeLabel}"
                   AutomationProperties.Name="Critical free space (GB)" />
        </Grid>

        <Separator Margin="0,8" />

        <TextBlock Text="About" FontWeight="SemiBold" />
        <TextBlock Text="What is running on this bench (build-stamped version, runtime, OpenTAP engine)."
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="Version" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AboutVersion}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="Commit" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding AboutCommit, Converter={x:Static conv:ShortIdConverter.Instance}}"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding AboutCommit}" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="Build (UTC)" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AboutBuildTimestamp}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="Runtime" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AboutRuntime}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="RID" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AboutRuntimeIdentifier}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="OpenTAP engine" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AboutOpenTapEngine}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <Button Content="Open crashes folder"
                Command="{Binding OpenCrashesFolderCommand}"
                IsVisible="{Binding AllowOsFolderBrowse}"
                HorizontalAlignment="Left" />

        <Separator Margin="0,8" />

        <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
        <TextBlock Text="Effective configuration and provenance (defaults → settings.json → environment → command line). Env/CLI overlays are read-only above and are not written back on Save. Copy diagnostics includes the About support block."
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Left" />
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                Padding="8"
                MaxHeight="280">
          <ScrollViewer>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="2*,2*,*,2*" ColumnSpacing="8">
                <TextBlock Text="Key" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="2" Text="Source" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="3" Text="Detail" FontWeight="SemiBold" FontSize="12" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProvenanceRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,2*,*,2*" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Key}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding EffectiveValue}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="12" />
                      <TextBlock Grid.Column="3" Text="{Binding SourceDetail}" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Separator Margin="0,8" />

        <TextBlock Text="OpenTAP packages &amp; plugins" FontWeight="SemiBold" />
        <TextBlock Text="Offline install only (tap package install / bake .TapPackage). Extra plugin directories load from the data directory's plugins folder at startup unless Engineer debug is on. Changing plugin directories requires an application restart — Refresh does not reload assemblies."
                   TextWrapping="Wrap"
                   Opacity="0.8" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh" Command="{Binding RefreshPackagesCommand}" />
          <Button Content="Copy path" Command="{Binding CopyPathCommand}" />
          <Button Content="Open folder"
                  Command="{Binding OpenFolderCommand}"
                  IsVisible="{Binding AllowOsFolderBrowse}" />
        </StackPanel>

        <TextBlock Text="Installed packages" FontWeight="SemiBold" Margin="0,4,0,0" />
        <ListBox ItemsSource="{Binding Packages}"
                 SelectedItem="{Binding SelectedPackage}"
                 MinHeight="100"
                 MaxHeight="180">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}  {1}  —  {2}">
                    <Binding Path="Name" />
                    <Binding Path="Version" />
                    <Binding Path="Path" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Plugin directories" FontWeight="SemiBold" Margin="0,4,0,0" />
        <ListBox ItemsSource="{Binding PluginDirectories}"
                 SelectedItem="{Binding SelectedPluginDirectory}"
                 MinHeight="80"
                 MaxHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}  [{1}]">
                    <Binding Path="Path" />
                    <Binding Path="Source" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
