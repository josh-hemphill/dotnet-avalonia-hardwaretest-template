<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Instruments"
             x:Class="HardwareTest.Features.Instruments.InstrumentsView"
             x:DataType="vm:InstrumentsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,240" ColumnSpacing="16" RowSpacing="12">
    <WrapPanel Grid.ColumnSpan="2">
      <Button Content="Discover VISA"
              Command="{Binding RefreshVisaDiscoverCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Discover OpenTAP" Command="{Binding RefreshOpenTapDiscoverCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Refresh plan slots" Command="{Binding RefreshSlotsCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Apply selected resource" Command="{Binding ApplySelectedResourceCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Query *IDN?" Command="{Binding QuerySelectedIdnCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="Explicitly queries *IDN? where the saved configuration supports identity. Opens a transport briefly." />
      <Button Content="Clear override" Command="{Binding ClearOverrideCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <Button Content="Save overrides" Command="{Binding SaveCommand}"
              Margin="0,0,8,4"
              IsEnabled="{Binding !IsBusy}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,8,4" />
      <TextBlock Text="Working…"
                 IsVisible="{Binding IsBusy}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Opacity="0.8"
                 Margin="0,0,8,4" />
    </WrapPanel>

    <Border Grid.Row="1" Grid.ColumnSpan="2"
            Padding="10,8"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            IsVisible="{Binding ShowCommissionStrip}">
      <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Program" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding PlanFilterOptions}"
                    SelectedItem="{Binding PlanFilter}"
                    MinWidth="180" MaxWidth="220" AutomationProperties.Name="Commissioning program" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding CommissionTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CommissionHint}" TextWrapping="Wrap" Opacity="0.85" />
          <TextBlock Text="{Binding ReadinessSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <Button Content="Go to Run"
                  Command="{Binding NavigateToRunCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="2"
            Padding="12,10"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            IsVisible="{Binding ShowDiscoverEmpty}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <TextBlock Text="Discover VISA to find resource addresses. A plan with confirmed addresses can run without discovery."
                   VerticalAlignment="Center"
                   Opacity="0.85"
                   TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Discover VISA"
                Command="{Binding RefreshVisaDiscoverCommand}"
                IsEnabled="{Binding !IsBusy}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <DockPanel Grid.Row="3" Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="OpenTAP plan slot overrides" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                 Text="Select a slot, then a resource and Apply. Query identity only when the saved configuration supports it." />
      <ListBox Focusable="True" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Plan instrument slots" ItemsSource="{Binding VisibleSlots}"
               SelectedItem="{Binding SelectedSlot}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SlotOverrideItemViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="6" Margin="0,6">
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="120"/>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Text="{Binding TypeName}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding HasLastIdn}" FontSize="12" Text="{Binding LastIdnSummary, StringFormat=Last IDN: {0}}" TextWrapping="Wrap"/>
              <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Text="Station resource override" FontSize="12"/>
                <TextBox PlaceholderText="Use plan address, or enter a station override" Text="{Binding OverrideResource}" AutomationProperties.Name="{Binding SlotName, StringFormat=Resource override for {0}}"/>
                <TextBlock Text="{Binding ConfigurationIssue}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Grid Grid.Row="3" Grid.Column="1" RowDefinitions="*,*" RowSpacing="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="VISA" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox Focusable="True" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Discovered VISA resources" ItemsSource="{Binding DiscoveredVisa}"
                 SelectedItem="{Binding SelectedVisa}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DiscoveredResourceItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HasIdn}"
                           Text="{Binding IdnSummary, StringFormat=IDN: {0}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Row="1">
        <TextBlock DockPanel.Dock="Top" Text="OpenTAP" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox Focusable="True" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Discovered OpenTAP resources" ItemsSource="{Binding DiscoveredOpenTap}"
                 SelectedItem="{Binding SelectedOpenTap}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:OpenTapDiscoveredResourceItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HasIdn}"
                           Text="{Binding IdnSummary, StringFormat=IDN: {0}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
               Text="Station overrides apply at run time without changing the saved plan. Discovery lists addresses; supported identity queries actively open the selected resource." />
  </Grid>
</UserControl>
