<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Home"
             x:Class="HardwareTest.Features.Home.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,24,0,24">
      <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="720">
        <TextBlock Text="{Binding Title}"
                   FontSize="36"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
      </StackPanel>

      <UniformGrid Columns="3" HorizontalAlignment="Stretch" Margin="0,8,0,0">
        <Border Margin="8"
                Padding="16"
                CornerRadius="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Getting started" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap"
                       Text="Open Run, confirm the DUT serial, pick the sample OpenTAP program, and start. Identity check and voltage sweep run under OpenTAP with mock instruments by default." />
          </StackPanel>
        </Border>

        <Border Margin="8"
                Padding="16"
                CornerRadius="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Programs &amp; instruments" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap"
                       Text="Locked OpenTAP .TapPlan programs ship under Programs/. Use Instruments to discover VISA resources and bind station roles for the bench." />
          </StackPanel>
        </Border>

        <Border Margin="8"
                Padding="16"
                CornerRadius="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Reports" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap"
                       Text="Passed and failed runs write Typst PDFs. Enable embed plots in Settings to include channel charts from run Samples." />
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
