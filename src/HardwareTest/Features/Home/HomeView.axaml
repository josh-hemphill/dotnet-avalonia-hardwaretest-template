<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareTest.Features.Home"
             xmlns:shell="using:HardwareTest.Features.Shell"
             x:Class="HardwareTest.Features.Home.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,24,0,24">
      <Border IsVisible="{Binding CrashStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Margin="16,0"
              Padding="12"
              CornerRadius="6"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              MaxWidth="920"
              HorizontalAlignment="Center">
        <TextBlock Text="{Binding CrashStatus}" TextWrapping="Wrap" Opacity="0.9" />
      </Border>

      <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="720">
        <TextBlock Text="{Binding Title}"
                   FontSize="36"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,8,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Stretch" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeShellTileViewModel">
            <Border Margin="8"
                    Padding="16"
                    CornerRadius="8"
                    MinWidth="{x:Static shell:ShellLayoutBreakpoints.HomeTileMinWidth}"
                    MaxWidth="420"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    IsVisible="{Binding IsVisible}">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                <Button Content="{Binding ActionLabel}"
                        Command="{Binding NavigateCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
